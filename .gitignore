# PMPLearningManagement .gitignore
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing and Coverage
coverage/
test-results/
playwright-report/
test-results.xml
results.xml
.nyc_output/

# Build outputs
dist/
build/
out/

# Vite
.vite/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Deployment
.vercel
.netlify/

# Cache and temporary files
.cache/
.temp/
.tmp/
*.tmp
*.cache

# prisma
prisma/*.db
prisma/*.db-journal
prisma/migrations/dev/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Thumbs.db
.DS_Store
*.Zone.Identifier

# Logs
logs
*.log
.github/*.log
.github/workflows/*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Database
*.sqlite
*.sqlite3
postgres_data/
redis_data/
pgadmin_data/

# Uploads
uploads/
temp/

# Bundle analyzer
.next/analyze/

# PWA
public/sw.js
public/workbox-*.js
public/worker-*.js
public/sw.js.map
public/workbox-*.js.map
public/worker-*.js.map

# Input documents (if containing sensitive/copyrighted data)
# Uncomment these lines if you have PDF files with copyright content
# docs/input/references/*.pdf
# docs/input/pmbok/*.pdf