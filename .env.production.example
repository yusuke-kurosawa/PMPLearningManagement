# ==========================================
# Production Environment Variables
# ==========================================
# SECURITY: Never commit actual values to the repository!
# Use this file as a template for .env.production.local
# Set actual values in GitHub Secrets for deployment

# ==========================================
# CRITICAL SECURITY VARIABLES (P0 Fix Required)
# ==========================================

# Master encryption key for data protection (64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=your_64_character_hex_key_here_do_not_use_this_example_key

# Hash pepper for password hashing (32 hex characters)
# Generate with: openssl rand -hex 16
HASH_PEPPER=your_32_character_hex_pepper_here

# Application secret for HMAC operations (32+ characters)
# Generate with: openssl rand -base64 32
APP_SECRET=your_application_secret_key_here_minimum_32_characters

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe for client-side)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# Environment name
VITE_APP_ENV=production

# Application base URL
VITE_APP_URL=https://yusuke-kurosawa.github.io/PMPLearningManagement

# API endpoint (when backend is implemented)
VITE_API_URL=https://api.pmplm.example.com

# ==========================================
# MONITORING & ANALYTICS (Optional)
# ==========================================

# Sentry DSN for error tracking
VITE_SENTRY_DSN=

# Google Analytics ID
VITE_GA_MEASUREMENT_ID=

# ==========================================
# REDIS CACHE (Upstash)
# ==========================================

# Upstash Redis REST URL
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST Token
UPSTASH_REDIS_REST_TOKEN=

# ==========================================
# FEATURE FLAGS
# ==========================================

# Enable PWA features
VITE_ENABLE_PWA=true

# Enable offline mode
VITE_ENABLE_OFFLINE=true

# Enable analytics
VITE_ENABLE_ANALYTICS=false

# ==========================================
# SECURITY HEADERS
# ==========================================

# Content Security Policy
VITE_CSP_ENABLED=true

# Strict Transport Security (HSTS)
VITE_HSTS_ENABLED=true

# ==========================================
# INSTRUCTIONS FOR SETUP
# ==========================================
#
# 1. Copy this file to .env.production.local
#    cp .env.production.example .env.production.local
#
# 2. Generate secure keys:
#    ENCRYPTION_MASTER_KEY: openssl rand -hex 32
#    HASH_PEPPER: openssl rand -hex 16
#    APP_SECRET: openssl rand -base64 32
#
# 3. Never commit .env.production.local to the repository
#    (it's already in .gitignore)
#
# 4. For GitHub Actions deployment, set these values in:
#    Settings > Secrets and variables > Actions > New repository secret
#
# 5. Required secrets for production deployment:
#    - ENCRYPTION_MASTER_KEY
#    - HASH_PEPPER
#    - APP_SECRET
#    - VITE_SUPABASE_URL
#    - VITE_SUPABASE_ANON_KEY
#
# ==========================================