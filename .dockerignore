# PMPLearningManagement .dockerignore

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# Build outputs
dist/
build/
coverage/

# Environment files
.env
.env.*

# Git
.git/
.gitignore

# Documentation
README.md
docs/
*.md

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Testing
test-results/
playwright-report/
coverage/

# Development tools
.eslintrc*
.prettierrc*
.editorconfig

# CI/CD
.github/
Dockerfile
.dockerignore
docker-compose.yml

# Cache
.cache/
.vite/
*.tsbuildinfo

# Temporary files
.tmp/
.temp/
*.tmp
*.log

# Data files (potentially large)
data/input/
data/output/

# Configuration files that shouldn't be in container
config/
deployment/
scripts/maintenance/

# Prisma
prisma/migrations/

# Backup files
*.backup
*.bak