{
  "name": "pmp-learning-management",
  "version": "2.0.0",
  "description": "PMBOK Learning Management System - Static Site with Modern Features",
  "homepage": "https://yusuke-kurosawa.github.io/PMPLearningManagement",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:auth": "playwright test e2e/tests/auth/",
    "test:e2e:learning": "playwright test e2e/tests/learning/",
    "test:e2e:visual": "playwright test --project=visual-regression",
    "test:e2e:accessibility": "playwright test --project=accessibility",
    "test:e2e:performance": "playwright test --project=performance",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:cross-browser": "playwright test --project=desktop-chromium --project=desktop-firefox --project=desktop-webkit",
    "test:e2e:comprehensive": "npm run test:e2e:auth && npm run test:e2e:learning && npm run test:e2e:visual",
    "test:a11y": "vitest run --reporter=verbose --testNamePattern=\"accessibility\"",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:integration": "vitest run --reporter=verbose --testPathPattern=\"integration\"",
    "test:mutation": "stryker run",
    "test:advanced": "npm run test:mutation && npm run test:coverage",
    "playwright:install": "playwright install",
    "prepare": "husky install || true",
    "security:audit": "npm audit --audit-level=high",
    "security:check": "npm run security:audit && node scripts/security-audit.js",
    "perf:check": "node scripts/check-bundle-size.js",
    "clean": "rm -rf dist coverage playwright-report test-results .turbo",
    "clean:all": "npm run clean && rm -rf node_modules package-lock.json",
    "idd:check": "node scripts/issue-quality-checker.js",
    "idd:report": "node scripts/issue-report-generator.js",
    "docs:consolidate": "node scripts/consolidate-docs.js",
    "quality:check": "node scripts/validate-pmbok-content.js && node scripts/check-content-quality.js",
    "quality:dashboard": "node scripts/generate-quality-dashboard.js",
    "fix:all": "node scripts/auto-fix/fix-all-issues.js",
    "lint:header": "eslint src --ext .js,.jsx,.ts,.tsx -c .eslintrc.header.json",
    "lint:header:fix": "eslint src --ext .js,.jsx,.ts,.tsx -c .eslintrc.header.json --fix",
    "header:validate": "npm run lint:header",
    "header:apply": "npm run lint:header:fix",
    "terminology:check": "node scripts/check-pmp-terminology.js",
    "terminology:check:all": "find src -type f \\( -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' -o -name '*.md' \\) -exec node scripts/check-pmp-terminology.js {} \\;",
    "terminology:validate": "npx tsx src/api/terminology/terminology-api.ts validate",
    "terminology:dashboard": "npm run dev -- --open /terminology-dashboard",
    "terminology:report": "node scripts/generate-terminology-report.js",
    "terminology:autofix": "node scripts/apply-terminology-fixes.js",
    "terminology:glossary": "npx tsx src/data/terminology/pmp-terminology-database.ts export",
    "terminology:metrics": "npx tsx src/api/terminology/terminology-api.ts metrics",
    "terminology:pre-commit": "node scripts/check-pmp-terminology.js",
    "terminology:install-hook": "cp scripts/check-pmp-terminology.js .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "api-docs:generate": "node scripts/generate-api-sdks.js",
    "api-docs:generate:typescript": "node scripts/generate-api-sdks.js --lang typescript",
    "api-docs:generate:python": "node scripts/generate-api-sdks.js --lang python",
    "api-docs:generate:java": "node scripts/generate-api-sdks.js --lang java",
    "api-docs:generate:csharp": "node scripts/generate-api-sdks.js --lang csharp",
    "api-docs:validate": "node scripts/validate-api-docs.js",
    "api-docs:validate:spec": "node scripts/validate-api-docs.js --no-examples --no-links --no-accessibility",
    "api-docs:validate:full": "node scripts/validate-api-docs.js --verbose",
    "api-docs:serve": "cd docs/api && python -m http.server 8080",
    "api-docs:build": "npm run api-docs:validate:spec && npm run api-docs:generate",
    "api-docs:test": "npm run api-docs:validate:full",
    "api-docs:publish": "npm run api-docs:build && npm run api-docs:test",
    "serena": "node scripts/serena-cli.js",
    "serena:init": "node scripts/serena-cli.js init",
    "serena:update": "node scripts/serena-cli.js update",
    "serena:validate": "node scripts/serena-cli.js validate",
    "serena:validate:deploy": "node scripts/serena-cli.js validate --deploy",
    "serena:report": "node scripts/serena-cli.js report",
    "serena:report:json": "node scripts/serena-cli.js report --format=json",
    "serena:report:markdown": "node scripts/serena-cli.js report --format=markdown",
    "serena:status": "node scripts/serena-cli.js status",
    "serena:clean": "node scripts/serena-cli.js clean",
    "serena:clean:all": "node scripts/serena-cli.js clean --logs",
    "serena:diagnose": "node scripts/serena-cli.js diagnose",
    "serena:interactive": "node scripts/serena-cli.js interactive",
    "serena:pre-commit": "node scripts/serena-pre-commit-hook.js",
    "serena:deploy:pre": "node scripts/serena-deploy-validator.js pre-deploy",
    "serena:deploy:post-build": "node scripts/serena-deploy-validator.js post-build",
    "serena:deploy:post-deploy": "node scripts/serena-deploy-validator.js post-deploy",
    "deploy:serena": "npm run serena:deploy:pre && npm run build && npm run serena:deploy:post-build && gh-pages -d dist && npm run serena:deploy:post-deploy",
    "context7:setup": "bash scripts/upstash-quick-start.sh",
    "context7:test": "node scripts/upstash-troubleshoot.js test",
    "context7:monitor": "node scripts/upstash-troubleshoot.js monitor",
    "context7:cache:clear": "node scripts/upstash-troubleshoot.js cache:clear",
    "context7:cache:rebuild": "node scripts/upstash-troubleshoot.js cache:rebuild",
    "context7:cache:stats": "node scripts/upstash-troubleshoot.js cache:stats",
    "context7:optimize": "node scripts/upstash-troubleshoot.js optimize",
    "context7:verify-keys": "node scripts/upstash-troubleshoot.js verify",
    "context7:test:connection": "node scripts/upstash-troubleshoot.js connection",
    "context7:prefetch": "node scripts/upstash-troubleshoot.js prefetch",
    "context7:health": "node scripts/upstash-troubleshoot.js health",
    "context7:config:apply": "cp ~/.config/Claude/claude_desktop_config_optimized.json ~/.config/Claude/claude_desktop_config.json",
    "context7:config:backup": "cp ~/.config/Claude/claude_desktop_config.json ~/.config/Claude/claude_desktop_config.backup.json",
    "context7:config:restore": "cp ~/.config/Claude/claude_desktop_config.backup.json ~/.config/Claude/claude_desktop_config.json",
    "context7:all": "npm run context7:setup && npm run context7:verify-keys && npm run context7:test",
    "upstash:setup": "node scripts/upstash-setup.js",
    "upstash:validate": "node scripts/upstash-validate.js",
    "upstash:test": "node scripts/upstash-test.js",
    "upstash:test:compare": "node scripts/upstash-test.js --compare",
    "upstash:troubleshoot": "node scripts/upstash-troubleshoot.js",
    "upstash:all": "npm run upstash:setup && npm run upstash:validate && npm run upstash:test",
    "context7:monitor:start": "node scripts/context7-monitor.js start",
    "context7:monitor:stop": "node scripts/context7-monitor.js stop",
    "context7:monitor:status": "node scripts/context7-monitor.js status",
    "context7:monitor:diagnostics": "node scripts/context7-monitor.js diagnostics",
    "dev:with-context7": "npm run context7:monitor:start && npm run dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.54.0",
    "@tanstack/react-query": "^5.17.9",
    "@tanstack/react-table": "^8.11.3",
    "@types/bcryptjs": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "d3": "^7.8.5",
    "d3-sankey": "^0.12.3",
    "date-fns": "^3.2.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.303.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.10.3",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.40.1",
    "@stryker-mutator/core": "^9.1.1",
    "@stryker-mutator/typescript-checker": "^9.1.1",
    "@stryker-mutator/vitest-runner": "^9.1.1",
    "@testing-library/jest-dom": "^6.1.6",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@upstash/redis": "^1.35.4",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "chai": "^5.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-vitest-globals": "^1.5.0",
    "fast-check": "^3.15.1",
    "gh-pages": "^6.1.0",
    "glob": "^11.0.3",
    "happy-dom": "^20.0.2",
    "husky": "^8.0.3",
    "jest-axe": "^8.0.0",
    "jest-mock-extended": "^4.0.0",
    "jest-when": "^3.6.0",
    "lint-staged": "^15.2.0",
    "msw": "^2.0.11",
    "nock": "^13.5.1",
    "node-mocks-http": "^1.17.2",
    "playwright": "^1.40.1",
    "postcss": "^8.4.33",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.10",
    "sinon": "^17.0.1",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.0",
    "terser": "^5.43.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^7.1.7",
    "vite-plugin-static-copy": "^3.1.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
