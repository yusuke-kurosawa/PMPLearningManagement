{
  "name": "pmp-learning-management",
  "version": "2.0.0",
  "description": "PMBOK Learning Management System - Static Site with Modern Features",
  "homepage": "https://yusuke-kurosawa.github.io/PMPLearningManagement",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:profile": "vite build --profile",
    "build:stats": "vite build --reporter=verbose",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "typecheck:trace": "tsc --noEmit --generateTrace trace",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:a11y": "vitest run --reporter=verbose --testNamePattern=\"accessibility\"",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:integration": "vitest run --reporter=verbose --testPathPattern=\"integration\"",
    "test:mutation": "stryker run",
    "test:advanced": "npm run test:mutation && npm run test:coverage",
    "playwright:install": "playwright install",
    "prepare": "husky install || true",
    "security:audit": "npm audit --audit-level=high",
    "security:check": "npm run security:audit && node scripts/security-audit.js",
    "perf:check": "node scripts/check-bundle-size.js",
    "clean": "rm -rf dist coverage playwright-report test-results .turbo",
    "clean:all": "npm run clean && rm -rf node_modules package-lock.json",
    "idd:check": "node scripts/issue-quality-checker.js",
    "idd:report": "node scripts/issue-report-generator.js",
    "docs:consolidate": "node scripts/consolidate-docs.js",
    "quality:check": "node scripts/validate-pmbok-content.js && node scripts/check-content-quality.js",
    "quality:dashboard": "node scripts/generate-quality-dashboard.js",
    "fix:all": "node scripts/auto-fix/fix-all-issues.js",
    "lint:header": "eslint src --ext .js,.jsx,.ts,.tsx -c .eslintrc.header.json",
    "lint:header:fix": "eslint src --ext .js,.jsx,.ts,.tsx -c .eslintrc.header.json --fix",
    "header:validate": "npm run lint:header",
    "header:apply": "npm run lint:header:fix",
    "audit:placement": "node scripts/document-placement-auditor.js",
    "audit:placement:fix": "node scripts/document-placement-auditor.js --fix",
    "ts:coverage": "echo 'TypeScript type coverage analysis' && find src -name '*.ts' -o -name '*.tsx' | wc -l",
    "ts:any-check": "grep -r 'any' src/ --include='*.ts' --include='*.tsx' | wc -l || echo '0'",
    "ts:performance": "npm run typecheck:trace && echo 'TypeScript compilation trace generated'",
    "build:measure": "time npm run build && echo 'Build time measurement completed'",
    "perf:typescript": "node scripts/typescript-performance-monitor.js",
    "perf:monitor": "npm run perf:typescript"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.54.0",
    "@tanstack/react-query": "^5.17.9",
    "@tanstack/react-table": "^8.11.3",
    "@types/bcryptjs": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "d3": "^7.8.5",
    "d3-sankey": "^0.12.3",
    "date-fns": "^3.2.0",
    "framer-motion": "^12.23.12",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.10.3",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.40.1",
    "@stryker-mutator/core": "^8.0.0",
    "@stryker-mutator/typescript-checker": "^8.0.0",
    "@stryker-mutator/vitest-runner": "^8.0.0",
    "@testing-library/jest-dom": "^6.1.6",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "chai": "^5.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-vitest-globals": "^1.5.0",
    "fast-check": "^3.15.1",
    "gh-pages": "^6.1.0",
    "happy-dom": "^18.0.1",
    "husky": "^8.0.3",
    "jest-axe": "^8.0.0",
    "jest-mock-extended": "^4.0.0",
    "jest-when": "^3.6.0",
    "lint-staged": "^15.2.0",
    "msw": "^2.0.11",
    "nock": "^13.5.1",
    "node-mocks-http": "^1.17.2",
    "playwright": "^1.40.1",
    "postcss": "^8.4.33",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.10",
    "sinon": "^17.0.1",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.0",
    "terser": "^5.43.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "pmbok",
    "project-management",
    "pmp",
    "itto",
    "learning",
    "visualization"
  ],
  "author": "",
  "license": "MIT"
}
