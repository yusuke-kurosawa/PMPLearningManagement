{
  "name": "pmp-learning-management",
  "version": "2.0.0",
  "description": "PMBOK Learning Management System - Static Site with Modern Features",
  "homepage": "https://yusuke-kurosawa.github.io/PMPLearningManagement",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:optimized": "NODE_ENV=production npm run build && npm run post-build:optimize",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "deploy": "npm run build:optimized && gh-pages -d dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test:run && npm run test:e2e",
    "test:mutation": "stryker run",
    "playwright:install": "playwright install",
    "prepare": "husky install",
    "security:audit": "npm audit --audit-level=high",
    "performance:check": "node scripts/performance-check.js",
    "performance:budget": "node scripts/check-bundle-size.js",
    "quality:check": "npm run lint && npm run typecheck && npm run test:run",
    "quality:fix": "npm run lint:fix && npm run format",
    "clean": "rm -rf dist coverage test-results playwright-report *.tsbuildinfo",
    "context:update": "./.claude/scripts/sync-context.sh",
    "context:view": "cat .claude/context/current-status.md",
    "context:consolidate": "node scripts/consolidate-docs.js",
    "context:cleanup": "npm run context:consolidate && npm run clean",
    "idd:setup": "bash scripts/setup-idd-automation.sh",
    "idd:check": "git log --oneline -10 | grep -E '#[0-9]+' || echo 'Non-compliant commits found!'",
    "idd:status": "git log --oneline -10 | while read line; do if echo \"$line\" | grep -qE '#[0-9]+'; then echo \"✓ $line\"; else echo \"✗ $line\"; fi; done",
    "idd:report": "node scripts/issue-report-generator.js",
    "health:check": "node scripts/health-check.js",
    "project:validate": "npm run typecheck && npm run lint && npm run test:run",
    "project:optimize": "npm run clean && npm run format && npm run build:optimized"
  },
  "overrides": {
    "tmp": "^0.2.4",
    "axios": "^1.8.2"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.54.0",
    "@tanstack/react-query": "^5.17.9",
    "@tanstack/react-table": "^8.11.3",
    "@types/bcryptjs": "^3.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "d3": "^7.8.5",
    "d3-sankey": "^0.12.3",
    "date-fns": "^3.2.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.10.3",
