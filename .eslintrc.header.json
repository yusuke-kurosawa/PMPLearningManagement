  "eslintConfig": {
    "plugins": ["header"],
    "rules": {
      "header/header": [
        "error",
        "block",
        {
          "pattern": "\\*\\s+@file\\s+.+\n\\s*\\*\\s+@description\\s+.+\n\\s*\\*\\s+@developer\\s+Developer\\s+\\d+:\\s+.+\n\\s*\\*\\s+@agent\\s+.+\n\\s*\\*\\s+@lastModified\\s+\\d{4}-\\d{2}-\\d{2}",
          "template": "/**\n * @file ${file}\n * @description ${description}\n * @developer ${developer}\n * @agent ${agent}\n * @lastModified ${date}\n */",
          "style": {
            "minLines": 6,
            "maxLines": 10
          }
        }
      ]
    }
  },
  "headerTemplates": {
    "typescript": {
      "defaultTemplate": "/**\n * @file ${relativePath}\n * @description ${componentDescription}\n * @developer ${developerInfo}\n * @agent ${agentInfo}\n * @lastModified ${currentDate}\n */",
      "requiredFields": [
        "@file",
        "@description", 
        "@developer",
        "@agent",
        "@lastModified"
      ],
      "optionalFields": [
        "@module",
        "@dependencies",
        "@exports",
        "@performance",
        "@security"
      ]
    }
  },
