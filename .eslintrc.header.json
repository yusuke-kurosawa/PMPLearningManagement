{
  "extends": "./.eslintrc.json",
  "plugins": ["header"],
  "rules": {
    "header/header": [
      "error",
      "block",
      [
        "*",
        " * ファイル説明: {description}",
        " * 開発者: {developer}",
        " * 専門分野: {specialization}",
        " * 作成日: {created}",
        " * 最終更新: {updated}",
        " * 依存関係: {dependencies}",
        " * セキュリティレベル: {security_level}",
        " "
      ],
      {
        "template": {
          "description": "ファイルの目的と機能を簡潔に記述",
          "developer": "Developer X",
          "specialization": "担当分野（例：認証システム、UI/UX、データベース）",
          "created": "YYYY-MM-DD",
          "updated": "YYYY-MM-DD",
          "dependencies": "主要な依存ライブラリ（React, TypeScript等）",
          "security_level": "Low/Medium/High/Critical"
        }
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/auth/**/*", "src/server/auth/**/*", "src/lib/auth/**/*"],
      "rules": {
        "header/header": [
          "error",
          "block",
          [
            "*",
            " * 認証・認可システム実装",
            " * Developer 1 (backend-developer): 包括的認可システム（RBAC）実装",
            " * セキュリティレベル: Critical",
            " * 依存関係: Supabase, JWT, React",
            " * 最終更新: {updated}",
            " "
          ]
        ]
      }
    },
    {
      "files": ["src/server/services/**/*", "src/server/routers/**/*"],
      "rules": {
        "header/header": [
          "error",
          "block", 
          [
            "*",
            " * バックエンドサービス実装",
            " * Developer 2 (microservices-architect): サーバーサイド・API基盤",
            " * 技術スタック: tRPC, Prisma",
            " * セキュリティレベル: High",
            " * 最終更新: {updated}",
            " "
          ]
        ]
      }
    },
    {
      "files": ["src/server/webhooks/**/*", "src/services/*stripe*", "src/services/*payment*"],
      "rules": {
        "header/header": [
          "error",
          "block",
          [
            "*",
            " * 決済システム統合",
            " * Developer 3 (backend-developer): 決済・サブスクリプション管理",
            " * 決済プロバイダー: Stripe",
            " * セキュリティレベル: Critical",
            " * 最終更新: {updated}",
            " "
          ]
        ]
      }
    },
    {
      "files": ["src/components/visualizations/**/*", "src/components/shared/**/*"],
      "rules": {
        "header/header": [
          "error",
          "block",
          [
            "*",
            " * UI/UXコンポーネント実装",
            " * Developer 4 (frontend-developer): フロントエンド・ビジュアライゼーション",
            " * 技術スタック: React, D3.js, Framer Motion",
            " * セキュリティレベル: Low",
            " * 最終更新: {updated}",
            " "
          ]
        ]
      }
    },
    {
      "files": ["src/lib/db/**/*", "src/server/repositories/**/*"],
      "rules": {
        "header/header": [
          "error",
          "block",
          [
            "*",
            " * データベース・永続化層実装",
            " * Developer 5 (database-admin): データベース・パフォーマンス最適化",
            " * 技術スタック: Prisma, PostgreSQL, Redis",
            " * セキュリティレベル: High",
            " * 最終更新: {updated}",
            " "
          ]
        ]
      }
    },
    {
      "files": ["src/lib/pwa/**/*", "src/components/mobile/**/*", "src/components/PWA*"],
      "rules": {
        "header/header": [
          "error",
          "block",
          [
            "*",
            " * PWA・モバイル機能実装",
            " * Developer 6 (mobile-app-developer): PWA & Mobile Developer",
            " * 機能: Service Worker, Cache API, Push Notifications",
            " * プラットフォーム: Progressive Web App",
            " * 最終更新: {updated}",
            " "
          ]
        ]
      }
    },
    {
      "files": ["src/lib/security/**/*", "src/lib/monitoring/**/*", "src/server/monitoring/**/*"],
      "rules": {
        "header/header": [
          "error",
          "block",
          [
            "*",
            " * セキュリティ・監視システム実装",
            " * Developer 7 (devops-engineer): セキュリティ・DevOpsエンジニア",
            " * 機能: 暗号化, レート制限, メトリクス収集",
            " * セキュリティレベル: Critical",
            " * 最終更新: {updated}",
            " "
          ]
        ]
      }
    },
    {
      "files": ["src/test/**/*", "**/*.test.*", "src/components/__tests__/**/*"],
      "rules": {
        "header/header": [
          "error",
          "block",
          [
            "*",
            " * テストケース実装",
            " * Developer 8 (qa-expert): 品質保証エンジニア",
            " * テストタイプ: {test_type}",
            " * 対象: {target}",
            " * 最終更新: {updated}",
            " "
          ]
        ]
      }
    },
    {
      "files": ["src/services/**/*", "src/contexts/**/*", "src/hooks/**/*"],
      "rules": {
        "header/header": [
          "error",
          "block",
          [
            "*",
            " * フロントエンドサービス・状態管理実装",
            " * Developer 9 (frontend-developer): React専門・状態管理",
            " * 技術スタック: React Context, Zustand, Custom Hooks",
            " * セキュリティレベル: Medium",
            " * 最終更新: {updated}",
            " "
          ]
        ]
      }
    },
    {
      "files": ["src/components/learning/**/*", "src/components/exam/**/*"],
      "rules": {
        "header/header": [
          "error",
          "block",
          [
            "*",
            " * 学習機能・教育コンテンツ実装",
            " * Developer 10 (frontend-developer): 教育システム・学習体験",
            " * 機能: フラッシュカード, 模擬試験, 進捗管理",
            " * セキュリティレベル: Low",
            " * 最終更新: {updated}",
            " "
          ]
        ]
      }
    }
  ]
}