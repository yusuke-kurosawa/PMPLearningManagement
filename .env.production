# Production Environment Configuration
NODE_ENV=production
VITE_APP_ENV=production

# API Configuration
VITE_API_BASE_URL=https://api.pmp-learning.com
VITE_API_TIMEOUT=15000

# Feature Flags - Production
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Build Configuration
VITE_BUILD_VERSION=$GITHUB_SHA
VITE_BUILD_TIMESTAMP=$BUILD_TIMESTAMP

# Security - Production
VITE_ALLOWED_ORIGINS=https://yusuke-kurosawa.github.io,https://pmp-learning.com

# Performance - Production
VITE_MAX_BUNDLE_SIZE=5120
VITE_MAX_ASSET_SIZE=1024

# Monitoring - Production
VITE_HEALTH_CHECK_INTERVAL=60000
VITE_ERROR_BOUNDARY_FALLBACK=true

# Accessibility - Production
VITE_A11Y_STRICT_MODE=true
VITE_REDUCED_MOTION_SUPPORT=true

# Features - Production
VITE_ENABLE_WEB_WORKERS=true
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_OFFLINE_MODE=false