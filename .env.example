# ============================================================================
# PMP Learning Management System - Environment Configuration
# ============================================================================

# Node Environment
NODE_ENV=development

# Application
APP_URL=http://localhost:3000
APP_NAME="PMP Learning Management"
APP_VERSION=2.0.0

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL Primary Database
DATABASE_URL="postgresql://pmpuser:pmppassword@localhost:5432/pmplearning?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pmplearning
DB_USER=pmpuser
DB_PASSWORD=pmppassword
DB_SSL_MODE=disable

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_ACQUIRE_TIMEOUT=60000
DB_POOL_IDLE_TIMEOUT=10000

# PostgreSQL Read Replica (optional)
DB_READ_REPLICA_HOST=
DB_READ_REPLICA_PORT=5432

# ============================================================================
# Redis Cache Configuration
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=pmp:
REDIS_TTL_DEFAULT=300

# ============================================================================
# Authentication
# ============================================================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# JWT Settings
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================================================
# Email Configuration
# ============================================================================

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pmplearning.com
SMTP_SECURE=false

# ============================================================================
# Storage Configuration
# ============================================================================

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ============================================================================
# Monitoring and Logging
# ============================================================================

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=14
LOG_MAX_SIZE=20m

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.1

# ============================================================================
# Security
# ============================================================================

# CORS Settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your-session-secret-change-in-production
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true

# Content Security Policy
CSP_DIRECTIVES="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline';"

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=false
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_API_DOCS=true
ENABLE_ANALYTICS=false

# ============================================================================
# GeoIP Services (Developer 1 Implementation)
# ============================================================================

# IP-API (無料プラン - 1000 req/min)
IPAPI_RATE_LIMIT=1000

# IPGeolocation API (有料プラン推奨)
IPGEOLOCATION_API_KEY=

# MaxMind GeoIP (エンタープライズ級精度)
MAXMIND_USER_ID=
MAXMIND_LICENSE_KEY=

# Geographic Restriction Settings
GEO_RESTRICTION_ENABLED=true
GEO_RESTRICTION_FAIL_SECURE=false
GEO_ALLOWED_COUNTRIES=JP,US,GB,DE,FR,CA,AU
GEO_BLOCKED_COUNTRIES=
GEO_BLOCK_PROXIES=true
GEO_BLOCK_VPN=false
GEO_BLOCK_TOR=true
GEO_BLOCK_HOSTING=false
GEO_THREAT_THRESHOLD=70

# ============================================================================
# Enhanced Security (Developer 2 - CSRF, Developer 3 - Encryption)
# ============================================================================

# CSRF Protection
CSRF_SECRET=your_csrf_secret_key_min_32_chars
CSRF_TOKEN_EXPIRY=3600
CSRF_SAME_SITE=strict

# Encryption Keys
ENCRYPTION_MASTER_KEY=your_master_encryption_key_32_chars
ENCRYPTION_KEY_ROTATION_INTERVAL=86400
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_DERIVATION_ITERATIONS=100000

# ============================================================================
# Third-party Services
# ============================================================================

# OpenAI API (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Stripe (optional)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Analytics (optional)
GA_TRACKING_ID=

# ============================================================================
# Development Tools
# ============================================================================

# PgAdmin
PGADMIN_EMAIL=admin@pmplearning.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Prisma Studio
PRISMA_STUDIO_PORT=5555

# Debug Settings
DEBUG=false
DEBUG_SQL=false
DEBUG_CACHE=false

# ============================================================================
# Backup and Maintenance
# ============================================================================

# Backup Settings
BACKUP_DIR=./database/backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is under maintenance. Please check back later."

# ============================================================================
# Deployment
# ============================================================================

# Docker Settings
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest

# CI/CD
CI_ENVIRONMENT=
DEPLOY_BRANCH=main
AUTO_DEPLOY=false