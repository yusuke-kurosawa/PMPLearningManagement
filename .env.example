# PMPLearningManagement Environment Variables Template
# Copy this file to .env and update the values

# Application Configuration
VITE_APP_NAME="PMP Learning Management"
VITE_APP_VERSION="2.0.0"
VITE_APP_DESCRIPTION="PMBOK Learning Management System"

# Environment
NODE_ENV="development"
VITE_ENVIRONMENT="development"

# API Configuration
VITE_API_BASE_URL="http://localhost:3001"
VITE_API_TIMEOUT="10000"

# Supabase Configuration
VITE_SUPABASE_URL="your-supabase-url"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Stripe Configuration (for payment features)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"

# Feature Flags
VITE_ENABLE_AUTH="true"
VITE_ENABLE_PAYMENTS="false"
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_PWA="true"
VITE_ENABLE_OFFLINE="true"
VITE_ENABLE_SERVICE_WORKER="true"

# Performance Configuration
VITE_ENABLE_SOURCE_MAPS="false"
VITE_BUNDLE_ANALYZER="false"
VITE_PRELOAD_ROUTES="true"

# Analytics (optional)
VITE_GA_TRACKING_ID=""
VITE_MIXPANEL_TOKEN=""

# Monitoring (optional)
VITE_SENTRY_DSN=""
VITE_HOTJAR_ID=""

# Development Tools
VITE_ENABLE_DEVTOOLS="true"
VITE_ENABLE_REACT_QUERY_DEVTOOLS="true"

# PWA Configuration
VITE_PWA_CACHE_NAME="pmp-learning-v2"
VITE_PWA_CACHE_VERSION="2.0.0"

# Build Configuration
BUILD_OUTPUT_DIR="dist"
BUILD_SOURCE_MAP="false"
BUILD_MINIFY="true"

# GitHub Pages
PUBLIC_URL="/PMPLearningManagement/"
HOMEPAGE="https://yusuke-kurosawa.github.io/PMPLearningManagement"

# Security
VITE_CSRF_TOKEN=""
VITE_SESSION_TIMEOUT="3600000"