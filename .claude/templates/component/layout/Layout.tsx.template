import React, { FC, ReactNode, useState } from 'react'
import { Outlet, useLocation } from 'react-router-dom'
import { cn } from '@/lib/utils'
import { motion, AnimatePresence } from 'framer-motion'
import { useTheme } from '@/contexts/ThemeContext'
import { useAuth } from '@/contexts/AuthContext'
import { Navigation } from '@/components/layout/Navigation'
import { Footer } from '@/components/layout/Footer'
import { MobileBottomNavigation } from '@/components/layout/MobileBottomNavigation'
import { Button } from '@/components/ui/button'
import { ScrollArea } from '@/components/ui/scroll-area'
import { {{SidebarIcon}}, {{MenuIcon}} } from 'lucide-react'

interface {{LayoutName}}LayoutProps {
  children?: ReactNode
  className?: string
  showSidebar?: boolean
  showFooter?: boolean
  showMobileNav?: boolean
}

/**
 * {{LayoutName}}Layout - {{Description}}
 * 
 * @component
 * @example
 * ```tsx
 * <{{LayoutName}}Layout showSidebar showFooter>
 *   <RouterContent />
 * </{{LayoutName}}Layout>
 * ```
 * 
 * @since {{Date}}
 * @author {{Author}}
 */
export const {{LayoutName}}Layout: FC<{{LayoutName}}LayoutProps> = ({
  children,
  className,
  showSidebar = {{ShowSidebar}},
  showFooter = {{ShowFooter}},
  showMobileNav = {{ShowMobileNav}}
}) => {
  // Hooks
  const location = useLocation()
  const { theme } = useTheme()
  const { user, isAuthenticated } = useAuth()
  
  // State
  const [sidebarOpen, setSidebarOpen] = useState(showSidebar)
  const [isMobile, setIsMobile] = useState(false)

  // Handle responsive behavior
  React.useEffect(() => {
    const handleResize = () => {
      const mobile = window.innerWidth < 768
      setIsMobile(mobile)
      if (mobile) {
        setSidebarOpen(false)
      }
    }

    handleResize()
    window.addEventListener('resize', handleResize)
    return () => window.removeEventListener('resize', handleResize)
  }, [])

  // Animation variants
  const sidebarVariants = {
    open: { x: 0, opacity: 1 },
    closed: { x: -300, opacity: 0 }
  }

  const contentVariants = {
    full: { marginLeft: 0 },
    withSidebar: { marginLeft: 300 }
  }

  return (
    <div className={cn('{{kebab-name}}-layout min-h-screen flex flex-col', className)}>
      {/* Header Navigation */}
      <header className="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
        <div className="container flex h-16 items-center">
          {showSidebar && (
            <Button
              variant="ghost"
              size="icon"
              onClick={() => setSidebarOpen(!sidebarOpen)}
              className="mr-4"
            >
              <{{MenuIcon}} className="h-5 w-5" />
              <span className="sr-only">Toggle sidebar</span>
            </Button>
          )}
          <Navigation />
        </div>
      </header>

      {/* Main Layout Container */}
      <div className="flex-1 flex relative">
        {/* Sidebar */}
        {showSidebar && (
          <AnimatePresence>
            {sidebarOpen && (
              <motion.aside
                className={cn(
                  '{{kebab-name}}-sidebar fixed md:relative z-40 h-full w-72 border-r bg-background',
                  {
                    'shadow-xl': isMobile
                  }
                )}
                variants={sidebarVariants}
                initial="closed"
                animate="open"
                exit="closed"
                transition={{ type: 'spring', stiffness: 300, damping: 30 }}
              >
                <ScrollArea className="h-full p-4">
                  <nav className="space-y-2">
                    <h3 className="mb-4 text-sm font-semibold text-muted-foreground">
                      {{SidebarTitle}}
                    </h3>
                    
                    {/* Sidebar Navigation Items */}
                    <Button
                      variant="ghost"
                      className="w-full justify-start"
                      asChild
                    >
                      <a href="#section-1">
                        <{{SidebarIcon}} className="mr-2 h-4 w-4" />
                        Section 1
                      </a>
                    </Button>
                    
                    <Button
                      variant="ghost"
                      className="w-full justify-start"
                      asChild
                    >
                      <a href="#section-2">
                        <{{SidebarIcon}} className="mr-2 h-4 w-4" />
                        Section 2
                      </a>
                    </Button>

                    {/* User Section */}
                    {isAuthenticated && user && (
                      <div className="border-t pt-4 mt-4">
                        <h4 className="mb-2 text-sm font-semibold text-muted-foreground">
                          User
                        </h4>
                        <div className="text-sm">
                          <p className="font-medium">{user.name}</p>
                          <p className="text-muted-foreground">{user.email}</p>
                        </div>
                      </div>
                    )}
                  </nav>
                </ScrollArea>
              </motion.aside>
            )}
          </AnimatePresence>
        )}

        {/* Overlay for mobile sidebar */}
        {isMobile && sidebarOpen && (
          <div
            className="fixed inset-0 bg-black/50 z-30 md:hidden"
            onClick={() => setSidebarOpen(false)}
          />
        )}

        {/* Main Content Area */}
        <motion.main
          className={cn('{{kebab-name}}-content flex-1 overflow-auto', {
            'md:ml-72': showSidebar && sidebarOpen && !isMobile
          })}
          animate={showSidebar && sidebarOpen && !isMobile ? 'withSidebar' : 'full'}
          transition={{ type: 'spring', stiffness: 300, damping: 30 }}
        >
          <div className="container py-6">
            {/* Breadcrumb */}
            <nav className="mb-4 text-sm text-muted-foreground" aria-label="Breadcrumb">
              <ol className="list-none p-0 inline-flex">
                <li className="flex items-center">
                  <a href="/" className="hover:text-foreground">Home</a>
                  <span className="mx-2">/</span>
                </li>
                <li className="flex items-center">
                  <span className="text-foreground">
                    {location.pathname.split('/').filter(Boolean).pop() || 'Current Page'}
                  </span>
                </li>
              </ol>
            </nav>

            {/* Page Content */}
            <AnimatePresence mode="wait">
              <motion.div
                key={location.pathname}
                initial={{ opacity: 0, y: 10 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0, y: -10 }}
                transition={{ duration: 0.2 }}
              >
                {children || <Outlet />}
              </motion.div>
            </AnimatePresence>
          </div>
        </motion.main>
      </div>

      {/* Footer */}
      {showFooter && !isMobile && (
        <Footer className="border-t" />
      )}

      {/* Mobile Bottom Navigation */}
      {showMobileNav && isMobile && (
        <MobileBottomNavigation />
      )}
    </div>
  )
}

{{LayoutName}}Layout.displayName = '{{LayoutName}}Layout'

export default {{LayoutName}}Layout