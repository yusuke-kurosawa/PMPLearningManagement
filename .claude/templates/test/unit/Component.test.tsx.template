import { describe, it, expect, beforeEach, afterEach, vi, Mock } from 'vitest'
import { render, screen, waitFor, within, cleanup } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import { axe, toHaveNoViolations } from 'jest-axe'
import { BrowserRouter } from 'react-router-dom'
import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
import { {{ComponentName}} } from '../{{ComponentName}}'
import type { {{ComponentName}}Props } from '../{{ComponentName}}'

// Add axe matchers
expect.extend(toHaveNoViolations)

// ============================================================================
// Test Setup
// ============================================================================

describe('{{ComponentName}}', () => {
  let queryClient: QueryClient
  let user: ReturnType<typeof userEvent.setup>

  // Mock functions
  const mockOnClick = vi.fn()
  const mockOnChange = vi.fn()
  const mockOnSubmit = vi.fn()

  // Default props
  const defaultProps: {{ComponentName}}Props = {
    // Add default props here
    className: 'test-class',
    onClick: mockOnClick,
    onChange: mockOnChange
  }

  // Setup before each test
  beforeEach(() => {
    // Reset mocks
    vi.clearAllMocks()
    
    // Setup query client
    queryClient = new QueryClient({
      defaultOptions: {
        queries: { retry: false },
        mutations: { retry: false }
      }
    })

    // Setup user event
    user = userEvent.setup()
  })

  // Cleanup after each test
  afterEach(() => {
    cleanup()
    vi.restoreAllMocks()
  })

  // Helper function to render component with providers
  const renderComponent = (props: Partial<{{ComponentName}}Props> = {}) => {
    return render(
      <QueryClientProvider client={queryClient}>
        <BrowserRouter>
          <{{ComponentName}} {...defaultProps} {...props} />
        </BrowserRouter>
      </QueryClientProvider>
    )
  }

  // ============================================================================
  // Rendering Tests
  // ============================================================================

  describe('Rendering', () => {
    it('should render without crashing', () => {
      renderComponent()
      expect(screen.getByTestId('{{kebab-name}}')).toBeInTheDocument()
    })

    it('should render with correct display name', () => {
      expect({{ComponentName}}.displayName).toBe('{{ComponentName}}')
    })

    it('should apply custom className', () => {
      renderComponent({ className: 'custom-class' })
      const element = screen.getByTestId('{{kebab-name}}')
      expect(element).toHaveClass('custom-class')
    })

    it('should render children correctly', () => {
      renderComponent({ children: <span>Test Content</span> })
      expect(screen.getByText('Test Content')).toBeInTheDocument()
    })

    it('should render in loading state', () => {
      renderComponent({ isLoading: true })
      expect(screen.getByText(/loading/i)).toBeInTheDocument()
    })

    it('should render in disabled state', () => {
      renderComponent({ disabled: true })
      const element = screen.getByTestId('{{kebab-name}}')
      expect(element).toHaveAttribute('aria-disabled', 'true')
    })

    it('should render with correct ARIA attributes', () => {
      renderComponent({
        'aria-label': 'Test Label',
        'aria-describedby': 'test-description'
      })
      const element = screen.getByTestId('{{kebab-name}}')
      expect(element).toHaveAttribute('aria-label', 'Test Label')
      expect(element).toHaveAttribute('aria-describedby', 'test-description')
    })
  })

  // ============================================================================
  // Props Tests
  // ============================================================================

  describe('Props', () => {
    it('should handle variant prop', () => {
      const { rerender } = renderComponent({ variant: 'primary' })
      expect(screen.getByTestId('{{kebab-name}}')).toHaveClass('{{kebab-name}}--primary')

      rerender(
        <QueryClientProvider client={queryClient}>
          <BrowserRouter>
            <{{ComponentName}} {...defaultProps} variant="secondary" />
          </BrowserRouter>
        </QueryClientProvider>
      )
      expect(screen.getByTestId('{{kebab-name}}')).toHaveClass('{{kebab-name}}--secondary')
    })

    it('should handle size prop', () => {
      const { rerender } = renderComponent({ size: 'sm' })
      expect(screen.getByTestId('{{kebab-name}}')).toHaveClass('{{kebab-name}}--sm')

      rerender(
        <QueryClientProvider client={queryClient}>
          <BrowserRouter>
            <{{ComponentName}} {...defaultProps} size="lg" />
          </BrowserRouter>
        </QueryClientProvider>
      )
      expect(screen.getByTestId('{{kebab-name}}')).toHaveClass('{{kebab-name}}--lg')
    })

    it('should forward additional props', () => {
      renderComponent({ 
        'data-custom': 'value',
        id: 'test-id'
      })
      const element = screen.getByTestId('{{kebab-name}}')
      expect(element).toHaveAttribute('data-custom', 'value')
      expect(element).toHaveAttribute('id', 'test-id')
    })
  })

  // ============================================================================
  // Interaction Tests
  // ============================================================================

  describe('Interactions', () => {
    it('should handle click events', async () => {
      renderComponent()
      const element = screen.getByTestId('{{kebab-name}}')
      
      await user.click(element)
      
      expect(mockOnClick).toHaveBeenCalledTimes(1)
      expect(mockOnClick).toHaveBeenCalledWith(
        expect.objectContaining({
          type: 'click'
        })
      )
    })

    it('should not trigger click when disabled', async () => {
      renderComponent({ disabled: true })
      const element = screen.getByTestId('{{kebab-name}}')
      
      await user.click(element)
      
      expect(mockOnClick).not.toHaveBeenCalled()
    })

    it('should handle keyboard navigation', async () => {
      renderComponent()
      const element = screen.getByTestId('{{kebab-name}}')
      
      element.focus()
      expect(element).toHaveFocus()
      
      await user.keyboard('{Enter}')
      expect(mockOnClick).toHaveBeenCalledTimes(1)
      
      await user.keyboard('{Space}')
      expect(mockOnClick).toHaveBeenCalledTimes(2)
    })

    it('should handle form submission', async () => {
      renderComponent({ onSubmit: mockOnSubmit })
      
      // Simulate form interaction
      const input = screen.getByRole('textbox', { name: /name/i })
      await user.type(input, 'Test Value')
      
      const submitButton = screen.getByRole('button', { name: /submit/i })
      await user.click(submitButton)
      
      expect(mockOnSubmit).toHaveBeenCalledWith(
        expect.objectContaining({
          name: 'Test Value'
        })
      )
    })
  })

  // ============================================================================
  // State Management Tests
  // ============================================================================

  describe('State Management', () => {
    it('should manage internal state correctly', async () => {
      renderComponent()
      
      // Initial state
      expect(screen.queryByText('State: active')).not.toBeInTheDocument()
      
      // Trigger state change
      const toggleButton = screen.getByRole('button', { name: /toggle/i })
      await user.click(toggleButton)
      
      // Verify state change
      await waitFor(() => {
        expect(screen.getByText('State: active')).toBeInTheDocument()
      })
    })

    it('should handle controlled component pattern', async () => {
      const { rerender } = renderComponent({ value: 'initial' })
      
      const input = screen.getByRole('textbox')
      expect(input).toHaveValue('initial')
      
      // Update controlled value
      rerender(
        <QueryClientProvider client={queryClient}>
          <BrowserRouter>
            <{{ComponentName}} {...defaultProps} value="updated" />
          </BrowserRouter>
        </QueryClientProvider>
      )
      
      expect(input).toHaveValue('updated')
    })
  })

  // ============================================================================
  // Async Operations Tests
  // ============================================================================

  describe('Async Operations', () => {
    it('should handle async data loading', async () => {
      const mockFetch = vi.fn().mockResolvedValue({ data: 'test data' })
      renderComponent({ onLoad: mockFetch })
      
      // Initial loading state
      expect(screen.getByText(/loading/i)).toBeInTheDocument()
      
      // Wait for data
      await waitFor(() => {
        expect(screen.queryByText(/loading/i)).not.toBeInTheDocument()
      })
      
      expect(screen.getByText('test data')).toBeInTheDocument()
      expect(mockFetch).toHaveBeenCalledTimes(1)
    })

    it('should handle async errors gracefully', async () => {
      const mockError = new Error('Test error')
      const mockFetch = vi.fn().mockRejectedValue(mockError)
      
      renderComponent({ onLoad: mockFetch })
      
      await waitFor(() => {
        expect(screen.getByText(/error/i)).toBeInTheDocument()
      })
      
      expect(screen.getByText('Test error')).toBeInTheDocument()
    })

    it('should retry failed operations', async () => {
      let attempts = 0
      const mockFetch = vi.fn().mockImplementation(() => {
        attempts++
        if (attempts < 3) {
          return Promise.reject(new Error('Retry'))
        }
        return Promise.resolve({ data: 'success' })
      })
      
      renderComponent({ onLoad: mockFetch, retryCount: 3 })
      
      await waitFor(() => {
        expect(screen.getByText('success')).toBeInTheDocument()
      })
      
      expect(mockFetch).toHaveBeenCalledTimes(3)
    })
  })

  // ============================================================================
  // Accessibility Tests
  // ============================================================================

  describe('Accessibility', () => {
    it('should have no accessibility violations', async () => {
      const { container } = renderComponent()
      const results = await axe(container)
      expect(results).toHaveNoViolations()
    })

    it('should support keyboard navigation', async () => {
      renderComponent()
      const element = screen.getByTestId('{{kebab-name}}')
      
      // Tab navigation
      await user.tab()
      expect(element).toHaveFocus()
      
      // Arrow key navigation
      await user.keyboard('{ArrowDown}')
      // Verify focus moved to next item
    })

    it('should announce changes to screen readers', () => {
      renderComponent()
      const liveRegion = screen.getByRole('status')
      expect(liveRegion).toHaveAttribute('aria-live', 'polite')
    })

    it('should have proper ARIA labels', () => {
      renderComponent()
      const button = screen.getByRole('button', { name: /action/i })
      expect(button).toHaveAttribute('aria-label')
    })
  })

  // ============================================================================
  // Performance Tests
  // ============================================================================

  describe('Performance', () => {
    it('should memoize expensive computations', () => {
      const expensiveComputation = vi.fn()
      const { rerender } = renderComponent({ 
        onCompute: expensiveComputation 
      })
      
      expect(expensiveComputation).toHaveBeenCalledTimes(1)
      
      // Re-render with same props
      rerender(
        <QueryClientProvider client={queryClient}>
          <BrowserRouter>
            <{{ComponentName}} {...defaultProps} onCompute={expensiveComputation} />
          </BrowserRouter>
        </QueryClientProvider>
      )
      
      // Should not recompute
      expect(expensiveComputation).toHaveBeenCalledTimes(1)
    })

    it('should debounce rapid updates', async () => {
      vi.useFakeTimers()
      renderComponent()
      
      const input = screen.getByRole('textbox')
      
      // Type rapidly
      await user.type(input, 'test')
      
      // onChange should not be called yet
      expect(mockOnChange).not.toHaveBeenCalled()
      
      // Fast forward time
      vi.advanceTimersByTime(300)
      
      // Now onChange should be called once
      expect(mockOnChange).toHaveBeenCalledTimes(1)
      expect(mockOnChange).toHaveBeenCalledWith('test')
      
      vi.useRealTimers()
    })
  })

  // ============================================================================
  // Edge Cases Tests
  // ============================================================================

  describe('Edge Cases', () => {
    it('should handle empty data gracefully', () => {
      renderComponent({ data: [] })
      expect(screen.getByText(/no data/i)).toBeInTheDocument()
    })

    it('should handle null/undefined props', () => {
      renderComponent({ 
        value: undefined,
        data: null 
      })
      expect(screen.getByTestId('{{kebab-name}}')).toBeInTheDocument()
    })

    it('should handle very long text', () => {
      const longText = 'a'.repeat(1000)
      renderComponent({ children: longText })
      const element = screen.getByTestId('{{kebab-name}}')
      expect(element).toHaveClass('truncate')
    })

    it('should handle rapid mounting/unmounting', () => {
      const { unmount } = renderComponent()
      unmount()
      
      // Should not throw errors
      expect(() => renderComponent()).not.toThrow()
    })
  })

  // ============================================================================
  // Integration Tests
  // ============================================================================

  describe('Integration', () => {
    it('should integrate with React Router', async () => {
      renderComponent()
      
      const link = screen.getByRole('link', { name: /navigate/i })
      await user.click(link)
      
      // Verify navigation occurred
      expect(window.location.pathname).toBe('/expected-path')
    })

    it('should integrate with React Query', async () => {
      const mockQuery = vi.fn().mockResolvedValue({ data: 'query result' })
      renderComponent({ queryFn: mockQuery })
      
      await waitFor(() => {
        expect(screen.getByText('query result')).toBeInTheDocument()
      })
      
      expect(mockQuery).toHaveBeenCalled()
    })

    it('should integrate with global state', () => {
      // Mock global state
      const mockStore = {
        user: { name: 'Test User' },
        theme: 'dark'
      }
      
      renderComponent({ store: mockStore })
      
      expect(screen.getByText('Test User')).toBeInTheDocument()
      expect(screen.getByTestId('{{kebab-name}}')).toHaveClass('dark')
    })
  })
})

// ============================================================================
// Snapshot Tests (optional)
// ============================================================================

describe('{{ComponentName}} - Snapshots', () => {
  it('should match snapshot', () => {
    const { container } = render(
      <BrowserRouter>
        <{{ComponentName}} {...defaultProps} />
      </BrowserRouter>
    )
    expect(container.firstChild).toMatchSnapshot()
  })
})