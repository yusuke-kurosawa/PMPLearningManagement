{
  "name": "@pmp-learning/template-generator",
  "version": "1.0.0",
  "description": "Production-ready template generation system with DevOps best practices",
  "main": "generator/index.js",
  "bin": {
    "generate": "cli/generate.js"
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint . --ext .js",
    "validate": "node cli/generate.js --validate",
    "list": "node cli/generate.js --list",
    "generate": "node cli/generate.js",
