{
  "version": "1.0.0",
  "environment": "production",
  "project": {
    "name": "PMPLearningManagement",
    "description": "Production Environment - PMBOK Learning Management System",
    "repository": "https://github.com/yusuke-kurosawa/PMPLearningManagement",
    "version": "1.0.0",
    "maintainers": [
      {
        "name": "Production Team",
        "email": "prod-team@example.com",
        "role": "Production Operations"
      }
    ]
  },
  "agents": {
    "enabled": [
      "deployment-engineer",
      "sre-engineer",
      "security-engineer",
      "monitoring-specialist"
    ],
    "defaultAgent": "sre-engineer",
    "timeout": 60000
  },
  "automation": {
    "enabled": true,
    "workflows": [
      {
        "name": "production-deployment",
        "trigger": "manual",
        "actions": ["validate", "backup", "deploy", "verify", "monitor"],
        "enabled": true
      },
      {
        "name": "production-rollback",
        "trigger": "manual",
        "actions": ["backup", "rollback", "verify", "alert"],
        "enabled": true
      },
      {
        "name": "production-monitoring",
        "trigger": "schedule",
        "actions": ["health-check", "metrics", "alert"],
        "enabled": true
      }
    ],
    "schedule": {
      "cleanup": "0 3 * * 0",
      "backup": "0 2 * * *",
      "healthCheck": "*/5 * * * *"
    }
  },
  "monitoring": {
    "enabled": true,
    "metrics": {
      "collection": true,
      "retention": 90,
      "exporters": ["prometheus", "datadog", "cloudwatch", "newrelic"]
    },
    "alerts": {
      "enabled": true,
      "channels": ["email", "slack", "pagerduty", "opsgenie"],
      "thresholds": {
        "errorRate": 0.001,
        "responseTime": 500,
        "availability": 0.9999,
        "diskUsage": 0.7,
        "memoryUsage": 0.8,
        "cpuUsage": 0.7
      }
    },
    "healthCheck": {
      "interval": 30000,
      "timeout": 3000,
      "retries": 5
    }
  },
  "security": {
    "scanning": {
      "enabled": true,
      "frequency": "continuous",
      "scanners": ["trivy", "snyk", "owasp-zap", "semgrep", "sonarqube"]
    },
    "access": {
      "authentication": "oauth2",
      "authorization": "rbac",
      "audit": true,
      "mfa": true
    },
    "compliance": {
      "standards": ["OWASP", "CIS", "PCI-DSS", "GDPR", "SOC2", "ISO27001"],
      "reporting": true,
      "automated": true
    }
  },
  "deployment": {
    "strategy": "blue-green",
    "environments": {
      "production": {
        "url": "https://pmplearning.com",
        "branch": "main",
        "autoDeploy": false,
        "approvalRequired": true,
        "rollbackWindow": 3600
      }
    },
    "rollback": {
      "enabled": true,
      "automatic": true,
      "conditions": [
        "health-check-failed",
        "error-rate-exceeded",
        "performance-degraded",
        "security-issue-detected"
      ],
      "maxAttempts": 3
    }
  },
  "performance": {
    "caching": {
      "enabled": true,
      "strategy": "multi-tier",
      "ttl": 86400,
      "cdn": true
    },
    "optimization": {
      "parallel": true,
      "workers": 8,
      "resourceLimits": {
        "maxMemory": "4GB",
        "maxCpu": "4",
        "maxDisk": "100GB"
      },
      "autoScaling": {
        "enabled": true,
        "minInstances": 2,
        "maxInstances": 10,
        "targetCpu": 60
      }
    }
  },
  "maintenance": {
    "backup": {
      "enabled": true,
      "frequency": "hourly",
      "retention": 90,
      "location": "s3://backups/production",
      "encryption": true,
      "verification": true
    },
    "cleanup": {
      "enabled": true,
      "frequency": "daily",
      "patterns": ["*.log", "*.tmp", ".cache"],
      "maxAge": 7
    }
  },
  "logging": {
    "level": "info",
    "destinations": ["cloudwatch", "elasticsearch", "s3"],
    "retention": 90,
    "encryption": true
  },
  "notifications": {
    "channels": {
      "slack": {
        "enabled": true,
        "webhook": "${SLACK_WEBHOOK_URL}",
        "channel": "#production-alerts"
      },
      "email": {
        "enabled": true,
        "recipients": ["ops@example.com", "oncall@example.com"]
      },
      "pagerduty": {
        "enabled": true,
        "serviceKey": "${PAGERDUTY_SERVICE_KEY}"
      }
    }
  }
}
