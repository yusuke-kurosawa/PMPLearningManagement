  "shortcuts": [
    {
      "name": "PMBOKマトリックス",
      "short_name": "マトリックス",
      "description": "プロセスマトリックスを表示",
      "url": "/pmbok/matrix",
      "icons": [{ "src": "icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "学習進捗",
      "short_name": "進捗",
      "description": "学習進捗を確認",
      "url": "/progress",
      "icons": [{ "src": "icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "フラッシュカード",
      "short_name": "カード",
