  # Phase 4: Automated Sustainability Monitoring
  sustainability-monitoring:
    name: 📊 Automated Sustainability Monitoring
    runs-on: ubuntu-latest
    needs: [esg-compliance-assessment]
    steps:
      - name: Setup Real-time Carbon Monitoring
        run: |
          echo \"🔍 Setting up real-time carbon and sustainability monitoring...\"
          
          # Create carbon monitoring configuration
          cat > carbon-monitoring-config.yaml << 'EOF'
apiVersion: v1
kind: ConfigMap
metadata:
  name: carbon-monitoring-config
  namespace: monitoring
  labels:
    app.kubernetes.io/name: carbon-monitor
    sustainability: enabled
data:
  carbon-monitor.yaml: |
    monitoring:
      carbon_metrics:
        enabled: true
        interval: 15m
        thresholds:
          warning: 0.03  # kg CO2
          critical: 0.05  # kg CO2
        export_destinations:
          - prometheus
          - grafana
          - esg_dashboard
          
      energy_efficiency:
        enabled: true
        targets:
          cpu_efficiency: 90
          memory_efficiency: 85
          storage_efficiency: 80
          
      renewable_energy:
        tracking_enabled: true
        target_percentage: 95
        regions_monitored:
          - us-west1
          - europe-west4
          - asia-southeast1
          
      sustainability_alerts:
        - name: carbon_budget_exceeded
          condition: carbon_footprint > 0.05
          severity: critical
          action: auto_scale_down
          
        - name: renewable_energy_low
          condition: renewable_percentage < 95
          severity: warning
          action: region_redirect
          
        - name: energy_efficiency_degraded
          condition: energy_efficiency < 90
          severity: warning
          action: resource_optimization
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: carbon-monitor
  namespace: monitoring
  labels:
    app.kubernetes.io/name: carbon-monitor
    app.kubernetes.io/component: sustainability
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: carbon-monitor
  template:
    metadata:
      labels:
        app.kubernetes.io/name: carbon-monitor
      annotations:
        prometheus.io/scrape: \"true\"
        prometheus.io/port: \"8080\"
        prometheus.io/path: \"/metrics\"
    spec:
      containers:
      - name: carbon-monitor
        image: sustainability/carbon-monitor:v1.0.0
        ports:
        - containerPort: 8080
          name: metrics
        - containerPort: 8090
          name: health
        env:
        - name: CARBON_BUDGET_LIMIT
          value: \"0.05\"
        - name: RENEWABLE_ENERGY_TARGET
          value: \"95\"
        - name: MONITORING_INTERVAL
          value: \"15m\"
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: 200m
            memory: 256Mi
        livenessProbe:
          httpGet:
            path: /health
            port: 8090
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /ready
            port: 8090
          initialDelaySeconds: 5
          periodSeconds: 5
EOF
          
      - name: Create Sustainability Dashboard
        run: |
          echo \"📊 Creating comprehensive sustainability dashboard...\"
          
          cat > sustainability-dashboard.json << 'EOF'
{
  "dashboard": {
    "id": null,
    "title": "🌱 Sustainability & ESG Dashboard",
    "tags": ["sustainability", "esg", "carbon", "green-devops"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "🌍 Real-time Carbon Footprint",
        "type": "stat",
        "targets": [
          {
            "expr": "carbon_footprint_kg_co2",
            "legendFormat": "CO2 Emissions (kg)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 0.03},
                {"color": "red", "value": 0.05}
              ]
            },
            "unit": "kg"
          }
        }
      },
      {
        "id": 2,
        "title": "⚡ Energy Efficiency Score",
        "type": "gauge",
        "targets": [
          {
            "expr": "energy_efficiency_percentage",
            "legendFormat": "Efficiency %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 85},
                {"color": "green", "value": 95}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "🌿 Renewable Energy Usage",
        "type": "bargauge",
        "targets": [
          {
            "expr": "renewable_energy_percentage by (region)",
            "legendFormat": "{{region}}"
          }
        ]
      },
      {
        "id": 4,
        "title": "📊 ESG Scores",
        "type": "stat",
        "targets": [
          {
            "expr": "esg_environmental_score",
            "legendFormat": "Environmental"
          },
          {
            "expr": "esg_social_score",
            "legendFormat": "Social"
          },
          {
            "expr": "esg_governance_score",
            "legendFormat": "Governance"
          }
        ]
      },
      {
        "id": 5,
        "title": "📈 Carbon Footprint Trend",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(carbon_footprint_kg_co2[5m])",
            "legendFormat": "Carbon Footprint Rate"
          }
        ]
      },
      {
        "id": 6,
        "title": "🎯 Sustainability KPIs",
        "type": "table",
        "targets": [
          {
            "expr": "sustainability_kpis",
            "format": "table"
          }
        ]
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "1m"
  }
}
EOF
          
          echo \"✅ Sustainability dashboard configuration created\"
          
      - name: Upload Monitoring Configuration
        uses: actions/upload-artifact@v4
        with:
          name: sustainability-monitoring
          path: |
            carbon-monitoring-config.yaml
            sustainability-dashboard.json
          retention-days: 90

