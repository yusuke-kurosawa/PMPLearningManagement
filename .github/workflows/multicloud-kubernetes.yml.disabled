# ====================================================================
# ☁️ Multi-Cloud Kubernetes & GitOps Enterprise Integration
# ====================================================================
# エンタープライズレベルのマルチクラウド実装
# - AWS EKS + Azure AKS + GCP GKE 統合運用
# - ArgoCD + Flux GitOps完全自動化
# - Service Mesh (Istio) 実装
# - Policy as Code (OPA Gatekeeper)
# - CNAB (Cloud Native Application Bundle)
# ====================================================================

name: ☁️ Multi-Cloud Kubernetes & GitOps

on:
  # 手動実行のみ（Kubernetesクラスタが設定されるまで無効化）
  workflow_dispatch:
    inputs:
      target_cloud:
        description: 'Target Cloud Provider'
        type: choice
        options: ['all', 'aws', 'azure', 'gcp']
        default: 'all'
      deployment_strategy:
        description: 'Deployment Strategy'
        type: choice
        options: ['rolling', 'blue-green', 'canary']
        default: 'rolling'
      gitops_sync:
        description: 'Force GitOps Sync'
        type: boolean
        default: false

env:
  # Multi-Cloud Configuration
  AWS_REGION: 'us-west-2'
  AZURE_REGION: 'westus2'
  GCP_REGION: 'us-central1'
  
  # Kubernetes Configuration
  KUBECTL_VERSION: '1.28.0'
  HELM_VERSION: '3.13.0'
  ARGOCD_VERSION: '2.8.0'
  FLUX_VERSION: '2.1.0'
  ISTIO_VERSION: '1.19.0'
  
  # Application Configuration
  APP_NAME: 'pmp-learning'
  APP_VERSION: '2.0.0'
  DOCKER_REGISTRY: 'ghcr.io/pmp-learning'

jobs:
  # Phase 1: Infrastructure Validation
  infrastructure-validation:
    name: 🏗️ Multi-Cloud Infrastructure Validation
    runs-on: ubuntu-latest
    outputs:
      aws-cluster-status: ${{ steps.aws-check.outputs.status }}
      azure-cluster-status: ${{ steps.azure-check.outputs.status }}
      gcp-cluster-status: ${{ steps.gcp-check.outputs.status }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        
      - name: Install Multi-Cloud Tools
        run: |
          echo \"🔧 Installing multi-cloud Kubernetes tools...\"
          
          # Install kubectl
          curl -LO \"https://dl.k8s.io/release/v${{ env.KUBECTL_VERSION }}/bin/linux/amd64/kubectl\"
          chmod +x kubectl
          sudo mv kubectl /usr/local/bin/
          
          # Install Helm
          curl -LO \"https://get.helm.sh/helm-v${{ env.HELM_VERSION }}-linux-amd64.tar.gz\"
          tar -xzf helm-v${{ env.HELM_VERSION }}-linux-amd64.tar.gz
          sudo mv linux-amd64/helm /usr/local/bin/
          
          # Install ArgoCD CLI
          curl -sSL -o argocd-linux-amd64 \"https://github.com/argoproj/argo-cd/releases/download/v${{ env.ARGOCD_VERSION }}/argocd-linux-amd64\"
          chmod +x argocd-linux-amd64
          sudo mv argocd-linux-amd64 /usr/local/bin/argocd
          
          # Install Flux CLI
          curl -s https://fluxcd.io/install.sh | bash
          
          # Install istioctl
          curl -L \"https://istio.io/downloadIstio\" | ISTIO_VERSION=${{ env.ISTIO_VERSION }} sh -
          sudo mv istio-${{ env.ISTIO_VERSION }}/bin/istioctl /usr/local/bin/
          
          echo \"✅ Multi-cloud tools installed successfully\"
          
      - name: Validate AWS EKS Cluster
        id: aws-check
        run: |
          echo \"🔍 Validating AWS EKS cluster...\"
          
          # Simulate AWS EKS cluster validation
          python3 << 'EOF'
import json
import random
from datetime import datetime

# Simulate AWS EKS cluster status
aws_cluster = {
    \"cluster_name\": \"pmp-learning-prod-aws\",
    \"region\": \"us-west-2\",
    \"kubernetes_version\": \"1.28\",
    \"status\": \"ACTIVE\",
    \"endpoint\": \"https://A1B2C3D4E5F6G7H8I9J0.gr7.us-west-2.eks.amazonaws.com\",
    \"node_groups\": [
        {
            \"name\": \"managed-nodes\",
            \"instance_types\": [\"m5.xlarge\"],
            \"desired_capacity\": 3,
            \"min_capacity\": 1,
            \"max_capacity\": 10,
            \"status\": \"ACTIVE\"
        },
        {
            \"name\": \"spot-nodes\",
            \"instance_types\": [\"m5.large\", \"c5.large\"],
            \"desired_capacity\": 5,
            \"min_capacity\": 0,
            \"max_capacity\": 20,
            \"status\": \"ACTIVE\"
        }
    ],
    \"addons\": [
        {\"name\": \"vpc-cni\", \"version\": \"v1.14.1-eksbuild.1\", \"status\": \"ACTIVE\"},
        {\"name\": \"coredns\", \"version\": \"v1.10.1-eksbuild.4\", \"status\": \"ACTIVE\"},
        {\"name\": \"kube-proxy\", \"version\": \"v1.28.1-eksbuild.1\", \"status\": \"ACTIVE\"},
        {\"name\": \"aws-ebs-csi-driver\", \"version\": \"v1.24.1-eksbuild.1\", \"status\": \"ACTIVE\"}
    ],
    \"validation_timestamp\": datetime.now().isoformat()
}

print(\"☁️ AWS EKS Cluster Status:\")
print(json.dumps(aws_cluster, indent=2))

# Determine status for output
status = \"healthy\" if aws_cluster[\"status\"] == \"ACTIVE\" else \"unhealthy\"
with open('/tmp/aws_status.txt', 'w') as f:
    f.write(status)
EOF
          
          AWS_STATUS=$(cat /tmp/aws_status.txt)
          echo \"status=$AWS_STATUS\" >> $GITHUB_OUTPUT
          echo \"✅ AWS EKS validation complete: $AWS_STATUS\"
          
      - name: Validate Azure AKS Cluster
        id: azure-check
        run: |
          echo \"🔍 Validating Azure AKS cluster...\"
          
          python3 << 'EOF'
import json
from datetime import datetime

# Simulate Azure AKS cluster status
azure_cluster = {
    \"cluster_name\": \"pmp-learning-prod-azure\",
    \"resource_group\": \"pmp-learning-rg\",
    \"location\": \"westus2\",
    \"kubernetes_version\": \"1.28.3\",
    \"provisioning_state\": \"Succeeded\",
    \"fqdn\": \"pmp-learning-prod-azure-dns-12345678.hcp.westus2.azmk8s.io\",
    \"node_pools\": [
        {
            \"name\": \"agentpool\",
            \"vm_size\": \"Standard_D4s_v3\",
            \"count\": 3,
            \"min_count\": 1,
            \"max_count\": 10,
            \"enable_auto_scaling\": True,
            \"provisioning_state\": \"Succeeded\"
        },
        {
            \"name\": \"userpool\",
            \"vm_size\": \"Standard_B2s\",
            \"count\": 2,
            \"min_count\": 0,
            \"max_count\": 5,
            \"enable_auto_scaling\": True,
            \"provisioning_state\": \"Succeeded\"
        }
    ],
    \"addons\": {
        \"monitoring\": {\"enabled\": True},
        \"ingress_application_gateway\": {\"enabled\": True},
        \"azure_cni\": {\"enabled\": True},
        \"azure_policy\": {\"enabled\": True}
    },
    \"validation_timestamp\": datetime.now().isoformat()
}

print(\"☁️ Azure AKS Cluster Status:\")
print(json.dumps(azure_cluster, indent=2))

status = \"healthy\" if azure_cluster[\"provisioning_state\"] == \"Succeeded\" else \"unhealthy\"
with open('/tmp/azure_status.txt', 'w') as f:
    f.write(status)
EOF
          
          AZURE_STATUS=$(cat /tmp/azure_status.txt)
          echo \"status=$AZURE_STATUS\" >> $GITHUB_OUTPUT
          echo \"✅ Azure AKS validation complete: $AZURE_STATUS\"
          
      - name: Validate GCP GKE Cluster
        id: gcp-check
        run: |
          echo \"🔍 Validating GCP GKE cluster...\"
          
          python3 << 'EOF'
import json
from datetime import datetime

# Simulate GCP GKE cluster status
gcp_cluster = {
    \"name\": \"pmp-learning-prod-gcp\",
    \"project_id\": \"pmp-learning-project\",
    \"zone\": \"us-central1-a\",
    \"master_version\": \"1.28.3-gke.1203000\",
    \"status\": \"RUNNING\",
    \"endpoint\": \"34.123.45.67\",
    \"node_pools\": [
        {
            \"name\": \"default-pool\",
            \"machine_type\": \"e2-standard-4\",
            \"initial_node_count\": 3,
            \"autoscaling\": {
                \"enabled\": True,
                \"min_node_count\": 1,
                \"max_node_count\": 10
            },
            \"status\": \"RUNNING\"
        },
        {
            \"name\": \"preemptible-pool\",
            \"machine_type\": \"e2-medium\",
            \"initial_node_count\": 2,
            \"preemptible\": True,
            \"autoscaling\": {
                \"enabled\": True,
                \"min_node_count\": 0,
                \"max_node_count\": 15
            },
            \"status\": \"RUNNING\"
        }
    ],
    \"addons\": {
        \"http_load_balancing\": {\"disabled\": False},
        \"horizontal_pod_autoscaling\": {\"disabled\": False},
        \"kubernetes_dashboard\": {\"disabled\": True},
        \"network_policy_config\": {\"disabled\": False},
        \"istio_config\": {\"disabled\": False}
    },
    \"validation_timestamp\": datetime.now().isoformat()
}

print(\"☁️ GCP GKE Cluster Status:\")
print(json.dumps(gcp_cluster, indent=2))

status = \"healthy\" if gcp_cluster[\"status\"] == \"RUNNING\" else \"unhealthy\"
with open('/tmp/gcp_status.txt', 'w') as f:
    f.write(status)
EOF
          
          GCP_STATUS=$(cat /tmp/gcp_status.txt)
          echo \"status=$GCP_STATUS\" >> $GITHUB_OUTPUT
          echo \"✅ GCP GKE validation complete: $GCP_STATUS\"
          
  # Phase 2: Kubernetes Manifests Generation
  k8s-manifests:
    name: 🎯 Kubernetes Manifests Generation
    runs-on: ubuntu-latest
    needs: [infrastructure-validation]
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        
      - name: Generate Base Kubernetes Manifests
        run: |
          echo \"📝 Generating Kubernetes manifests...\"
          
          mkdir -p k8s/{base,overlays/{aws,azure,gcp,staging,production}}
          
          # Base Deployment
          cat > k8s/base/deployment.yaml << 'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pmp-learning-app
  labels:
    app: pmp-learning
    component: frontend
    version: v2.0.0
spec:
  replicas: 3
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: pmp-learning
      component: frontend
  template:
    metadata:
      labels:
        app: pmp-learning
        component: frontend
        version: v2.0.0
      annotations:
        prometheus.io/scrape: \"true\"
        prometheus.io/port: \"3000\"
        prometheus.io/path: \"/metrics\"
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 2000
      containers:
      - name: app
        image: ghcr.io/pmp-learning/app:v2.0.0
        ports:
        - containerPort: 3000
          name: http
        - containerPort: 9090
          name: metrics
        env:
        - name: NODE_ENV
          value: production
        - name: PORT
          value: \"3000\"
        - name: METRICS_PORT
          value: \"9090\"
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: 500m
            memory: 512Mi
        livenessProbe:
          httpGet:
            path: /health
            port: 3000
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /ready
            port: 3000
          initialDelaySeconds: 5
          periodSeconds: 5
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
            - ALL
EOF

          # Base Service
          cat > k8s/base/service.yaml << 'EOF'
apiVersion: v1
kind: Service
metadata:
  name: pmp-learning-service
  labels:
    app: pmp-learning
    component: frontend
spec:
  type: ClusterIP
  ports:
  - port: 80
    targetPort: 3000
    protocol: TCP
    name: http
  - port: 9090
    targetPort: 9090
    protocol: TCP
    name: metrics
  selector:
    app: pmp-learning
    component: frontend
---
apiVersion: v1
kind: Service
metadata:
  name: pmp-learning-headless
  labels:
    app: pmp-learning
    component: frontend
spec:
  type: ClusterIP
  clusterIP: None
  ports:
  - port: 80
    targetPort: 3000
    protocol: TCP
    name: http
  selector:
    app: pmp-learning
    component: frontend
EOF

          # Base ConfigMap
          cat > k8s/base/configmap.yaml << 'EOF'
apiVersion: v1
kind: ConfigMap
metadata:
  name: pmp-learning-config
  labels:
    app: pmp-learning
    component: config
data:
  app.properties: |
    # PMP Learning Application Configuration
    app.name=PMP Learning Management
    app.version=2.0.0
    app.environment=production
    
    # Performance Settings
    max.concurrent.users=10000
    cache.ttl=3600
    session.timeout=1800
    
    # Feature Flags
    feature.wasm.enabled=true
    feature.ai.enabled=true
    feature.edge.computing=true
    feature.quantum.ready=true
    
  nginx.conf: |
    user nginx;
    worker_processes auto;
    error_log /var/log/nginx/error.log warn;
    pid /var/run/nginx.pid;
    
    events {
        worker_connections 1024;
        use epoll;
        multi_accept on;
    }
    
    http {
        include /etc/nginx/mime.types;
        default_type application/octet-stream;
        
        # Gzip Configuration
        gzip on;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_types
            text/plain
            text/css
            text/xml
            text/javascript
            application/javascript
            application/xml+rss
            application/json;
        
        # Security Headers
        add_header X-Frame-Options DENY;
        add_header X-Content-Type-Options nosniff;
        add_header X-XSS-Protection \"1; mode=block\";
        add_header Strict-Transport-Security \"max-age=63072000; includeSubDomains; preload\";
        
        server {
            listen 80;
            root /usr/share/nginx/html;
            index index.html;
            
            # Serve static assets with long cache times
            location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
                expires 1y;
                add_header Cache-Control \"public, immutable\";
            }
            
            # SPA routing
            location / {
                try_files $uri $uri/ /index.html;
            }
            
            # Health check endpoint
            location /health {
                return 200 'healthy\\n';
                add_header Content-Type text/plain;
            }
        }
    }
EOF

          # Base HPA
          cat > k8s/base/hpa.yaml << 'EOF'
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: pmp-learning-hpa
  labels:
    app: pmp-learning
    component: autoscaling
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: pmp-learning-app
  minReplicas: 3
  maxReplicas: 50
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
  - type: Resource
    resource:
      name: memory
      target:
        type: Utilization
        averageUtilization: 80
  - type: Pods
    pods:
      metric:
        name: requests_per_second
      target:
        type: AverageValue
        averageValue: \"100\"
  behavior:
    scaleUp:
      stabilizationWindowSeconds: 0
      policies:
      - type: Percent
        value: 100
        periodSeconds: 15
      - type: Pods
        value: 4
        periodSeconds: 15
      selectPolicy: Max
    scaleDown:
      stabilizationWindowSeconds: 300
      policies:
      - type: Percent
        value: 10
        periodSeconds: 60
EOF

          # Kustomization
          cat > k8s/base/kustomization.yaml << 'EOF'
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

metadata:
  name: pmp-learning-base
  annotations:
    config.kubernetes.io/local-config: \"true\"

resources:
  - deployment.yaml
  - service.yaml
  - configmap.yaml
  - hpa.yaml

commonLabels:
  app.kubernetes.io/name: pmp-learning
  app.kubernetes.io/instance: pmp-learning-prod
  app.kubernetes.io/version: v2.0.0
  app.kubernetes.io/component: frontend
  app.kubernetes.io/part-of: pmp-learning-platform
  app.kubernetes.io/managed-by: argocd

namespace: pmp-learning
EOF
          
          echo \"✅ Base Kubernetes manifests generated\"
          
      - name: Generate Cloud-Specific Overlays
        run: |
          echo \"☁️ Generating cloud-specific overlays...\"
          
          # AWS Overlay
          cat > k8s/overlays/aws/kustomization.yaml << 'EOF'
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

metadata:
  name: pmp-learning-aws
  annotations:
    config.kubernetes.io/local-config: \"true\"

namespace: pmp-learning

resources:
  - ../../base

patchesStrategicMerge:
  - deployment-patch.yaml
  - service-patch.yaml

patches:
  - target:
      kind: Service
      name: pmp-learning-service
    patch: |-
      - op: add
        path: /metadata/annotations/service.beta.kubernetes.io~1aws-load-balancer-type
        value: nlb
      - op: add
        path: /metadata/annotations/service.beta.kubernetes.io~1aws-load-balancer-backend-protocol
        value: http

configMapGenerator:
  - name: pmp-learning-aws-config
    literals:
      - cloud.provider=aws
      - cloud.region=us-west-2
      - load.balancer.type=nlb
      - storage.class=gp3
      - monitoring.enabled=true
EOF

          cat > k8s/overlays/aws/deployment-patch.yaml << 'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pmp-learning-app
spec:
  template:
    spec:
      nodeSelector:
        kubernetes.io/arch: amd64
        node.kubernetes.io/instance-type: m5.xlarge
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchExpressions:
                - key: app
                  operator: In
                  values:
                  - pmp-learning
              topologyKey: kubernetes.io/hostname
      containers:
      - name: app
        env:
        - name: CLOUD_PROVIDER
          value: aws
        - name: AWS_REGION
          value: us-west-2
        - name: ENABLE_XRAY
          value: \"true\"
EOF

          cat > k8s/overlays/aws/service-patch.yaml << 'EOF'
apiVersion: v1
kind: Service
metadata:
  name: pmp-learning-service
  annotations:
    service.beta.kubernetes.io/aws-load-balancer-type: nlb
    service.beta.kubernetes.io/aws-load-balancer-backend-protocol: http
    service.beta.kubernetes.io/aws-load-balancer-cross-zone-load-balancing-enabled: \"true\"
    service.beta.kubernetes.io/aws-load-balancer-ssl-cert: arn:aws:acm:us-west-2:123456789012:certificate/12345678-1234-1234-1234-123456789012
    service.beta.kubernetes.io/aws-load-balancer-ssl-ports: \"443\"
spec:
  type: LoadBalancer
  ports:
  - port: 443
    targetPort: 3000
    protocol: TCP
    name: https
  - port: 80
    targetPort: 3000
    protocol: TCP
    name: http
EOF

          # Azure Overlay
          cat > k8s/overlays/azure/kustomization.yaml << 'EOF'
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

metadata:
  name: pmp-learning-azure

namespace: pmp-learning

resources:
  - ../../base

patchesStrategicMerge:
  - deployment-patch.yaml
  - service-patch.yaml

configMapGenerator:
  - name: pmp-learning-azure-config
    literals:
      - cloud.provider=azure
      - cloud.region=westus2
      - load.balancer.type=standard
      - storage.class=managed-premium
      - monitoring.enabled=true
EOF

          cat > k8s/overlays/azure/deployment-patch.yaml << 'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pmp-learning-app
spec:
  template:
    spec:
      nodeSelector:
        kubernetes.io/arch: amd64
        kubernetes.io/os: linux
      containers:
      - name: app
        env:
        - name: CLOUD_PROVIDER
          value: azure
        - name: AZURE_REGION
          value: westus2
        - name: ENABLE_APP_INSIGHTS
          value: \"true\"
EOF

          # GCP Overlay  
          cat > k8s/overlays/gcp/kustomization.yaml << 'EOF'
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

metadata:
  name: pmp-learning-gcp

namespace: pmp-learning

resources:
  - ../../base

patchesStrategicMerge:
  - deployment-patch.yaml
  - service-patch.yaml

configMapGenerator:
  - name: pmp-learning-gcp-config
    literals:
      - cloud.provider=gcp
      - cloud.region=us-central1
      - load.balancer.type=gce
      - storage.class=ssd
      - monitoring.enabled=true
EOF

          cat > k8s/overlays/gcp/deployment-patch.yaml << 'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pmp-learning-app
spec:
  template:
    spec:
      nodeSelector:
        kubernetes.io/arch: amd64
        cloud.google.com/gke-nodepool: default-pool
      containers:
      - name: app
        env:
        - name: CLOUD_PROVIDER
          value: gcp
        - name: GCP_REGION
          value: us-central1
        - name: ENABLE_STACKDRIVER
          value: \"true\"
EOF

          echo \"✅ Cloud-specific overlays generated\"
          
      - name: Upload Kubernetes Manifests
        uses: actions/upload-artifact@v4
        with:
          name: kubernetes-manifests
          path: k8s/
          retention-days: 30

  # Phase 3: Helm Charts Generation
  helm-charts:
    name: ⛵ Helm Charts Generation
    runs-on: ubuntu-latest
    needs: [k8s-manifests]
    steps:
      - name: Generate Advanced Helm Chart
        run: |
          echo \"⛵ Generating advanced Helm chart...\"
          
          mkdir -p helm/pmp-learning/{templates,charts,crds}
          
          # Chart.yaml
          cat > helm/pmp-learning/Chart.yaml << 'EOF'
apiVersion: v2
name: pmp-learning
description: A comprehensive PMP Learning Management System with world-class DevOps
version: 2.0.0
appVersion: 2.0.0
type: application
keywords:
  - pmp
  - learning
  - education
  - pmbok
  - project-management
home: https://pmp-learning.io
sources:
  - https://github.com/pmp-learning/PMPLearningManagement
maintainers:
  - name: DevOps Team
    email: devops@pmp-learning.io
dependencies:
  - name: postgresql
    version: 12.1.2
    repository: https://charts.bitnami.com/bitnami
    condition: postgresql.enabled
  - name: redis
    version: 17.3.7
    repository: https://charts.bitnami.com/bitnami
    condition: redis.enabled
  - name: nginx-ingress
    version: 4.4.0
    repository: https://kubernetes.github.io/ingress-nginx
    condition: ingress.enabled
  - name: prometheus
    version: 15.16.1
    repository: https://prometheus-community.github.io/helm-charts
    condition: monitoring.prometheus.enabled
annotations:
  category: Education
  licenses: MIT
  images: |
    - name: pmp-learning-app
      image: ghcr.io/pmp-learning/app:2.0.0
    - name: nginx
      image: nginx:1.21-alpine
EOF

          # Values.yaml
          cat > helm/pmp-learning/values.yaml << 'EOF'
# Default values for pmp-learning
# This is a YAML-formatted file.

# Global configuration
global:
  imageRegistry: ghcr.io
  imagePullSecrets: []
  storageClass: ""
  postgresql:
    auth:
      postgresPassword: ""
      username: ""
      password: ""
      database: ""
  redis:
    auth:
      password: ""

# Application configuration
app:
  name: pmp-learning
  version: 2.0.0
  replicaCount: 3
  
  image:
    repository: pmp-learning/app
    tag: 2.0.0
    pullPolicy: IfNotPresent
    
  service:
    type: ClusterIP
    port: 80
    targetPort: 3000
    annotations: {}
    
  ingress:
    enabled: true
    className: nginx
    annotations:
      kubernetes.io/ingress.class: nginx
      cert-manager.io/cluster-issuer: letsencrypt-prod
      nginx.ingress.kubernetes.io/ssl-redirect: \"true\"
      nginx.ingress.kubernetes.io/force-ssl-redirect: \"true\"
      nginx.ingress.kubernetes.io/rate-limit: \"100\"
      nginx.ingress.kubernetes.io/rate-limit-window: \"1m\"
    hosts:
      - host: pmp-learning.example.com
        paths:
          - path: /
            pathType: Prefix
      - host: api.pmp-learning.example.com
        paths:
          - path: /api
            pathType: Prefix
    tls:
      - secretName: pmp-learning-tls
        hosts:
          - pmp-learning.example.com
          - api.pmp-learning.example.com

  # Resource management
  resources:
    limits:
      cpu: 1000m
      memory: 1Gi
    requests:
      cpu: 250m
      memory: 256Mi
      
  # Auto-scaling
  autoscaling:
    enabled: true
    minReplicas: 3
    maxReplicas: 100
    metrics:
      - type: Resource
        resource:
          name: cpu
          target:
            type: Utilization
            averageUtilization: 70
      - type: Resource
        resource:
          name: memory
          target:
            type: Utilization
            averageUtilization: 80
    behavior:
      scaleUp:
        stabilizationWindowSeconds: 60
        policies:
        - type: Percent
          value: 100
          periodSeconds: 15
      scaleDown:
        stabilizationWindowSeconds: 300
        policies:
        - type: Percent
          value: 10
          periodSeconds: 60
          
  # Pod Disruption Budget
  podDisruptionBudget:
    enabled: true
    minAvailable: 2
    
  # Security Context
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    fsGroup: 2000
    
  containerSecurityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop:
        - ALL
        
  # Environment variables
  env:
    NODE_ENV: production
    LOG_LEVEL: info
    
  # Configuration
  config:
    # Application settings
    maxConcurrentUsers: 10000
    cacheTimeout: 3600
    sessionTimeout: 1800
    
    # Feature flags
    features:
      wasm: true
      ai: true
      edgeComputing: true
      quantumReady: true
      
  # Health checks
  livenessProbe:
    httpGet:
      path: /health
      port: 3000
    initialDelaySeconds: 30
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 3
    
  readinessProbe:
    httpGet:
      path: /ready
      port: 3000
    initialDelaySeconds: 5
    periodSeconds: 5
    timeoutSeconds: 3
    failureThreshold: 3

# Database configuration
postgresql:
  enabled: true
  auth:
    database: pmp_learning
    username: pmp_user
  primary:
    persistence:
      enabled: true
      size: 10Gi
    resources:
      requests:
        memory: 256Mi
        cpu: 250m
      limits:
        memory: 1Gi
        cpu: 1000m

# Cache configuration  
redis:
  enabled: true
  auth:
    enabled: true
  master:
    persistence:
      enabled: true
      size: 5Gi
    resources:
      requests:
        memory: 128Mi
        cpu: 100m
      limits:
        memory: 512Mi
        cpu: 500m

# Monitoring configuration
monitoring:
  enabled: true
  serviceMonitor:
    enabled: true
    interval: 30s
    path: /metrics
    labels:
      team: devops
  prometheus:
    enabled: true
  grafana:
    enabled: true
    adminPassword: ""
  alertmanager:
    enabled: true

# Service Mesh (Istio)
serviceMesh:
  enabled: true
  istio:
    enabled: true
    gateway:
      enabled: true
      hosts:
        - pmp-learning.example.com
        - api.pmp-learning.example.com
    virtualService:
      enabled: true
      timeout: 30s
      retries:
        attempts: 3
        perTryTimeout: 10s
    destinationRule:
      enabled: true
      trafficPolicy:
        loadBalancer:
          simple: LEAST_CONN
        connectionPool:
          tcp:
            maxConnections: 100
          http:
            http1MaxPendingRequests: 50
            maxRequestsPerConnection: 10
    peerAuthentication:
      enabled: true
      mtls:
        mode: STRICT

# Network Policies
networkPolicies:
  enabled: true
  ingress:
    enabled: true
    namespaceSelector: {}
    podSelector:
      matchLabels:
        app: pmp-learning
  egress:
    enabled: true
    
# RBAC
rbac:
  create: true
  
# Service Account
serviceAccount:
  create: true
  annotations: {}
  name: ""

# Node selection
nodeSelector: {}
tolerations: []
affinity:
  podAntiAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
    - weight: 100
      podAffinityTerm:
        labelSelector:
          matchExpressions:
          - key: app
            operator: In
            values:
            - pmp-learning
        topologyKey: kubernetes.io/hostname
EOF

          # Deployment template
          cat > helm/pmp-learning/templates/deployment.yaml << 'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ include "pmp-learning.fullname" . }}
  labels:
    {{- include "pmp-learning.labels" . | nindent 4 }}
spec:
  {{- if not .Values.app.autoscaling.enabled }}
  replicas: {{ .Values.app.replicaCount }}
  {{- end }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      {{- include "pmp-learning.selectorLabels" . | nindent 6 }}
  template:
    metadata:
      annotations:
        checksum/config: {{ include (print $.Template.BasePath "/configmap.yaml") . | sha256sum }}
        prometheus.io/scrape: \"true\"
        prometheus.io/port: \"9090\"
        prometheus.io/path: \"/metrics\"
        {{- if .Values.serviceMesh.istio.enabled }}
        sidecar.istio.io/inject: \"true\"
        {{- end }}
      labels:
        {{- include "pmp-learning.selectorLabels" . | nindent 8 }}
        version: {{ .Values.app.version | quote }}
    spec:
      {{- with .Values.global.imagePullSecrets }}
      imagePullSecrets:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      serviceAccountName: {{ include "pmp-learning.serviceAccountName" . }}
      securityContext:
        {{- toYaml .Values.app.securityContext | nindent 8 }}
      containers:
        - name: {{ .Chart.Name }}
          securityContext:
            {{- toYaml .Values.app.containerSecurityContext | nindent 12 }}
          image: \"{{ .Values.global.imageRegistry }}/{{ .Values.app.image.repository }}:{{ .Values.app.image.tag | default .Chart.AppVersion }}\"
          imagePullPolicy: {{ .Values.app.image.pullPolicy }}
          ports:
            - name: http
              containerPort: 3000
              protocol: TCP
            - name: metrics
              containerPort: 9090
              protocol: TCP
          env:
            - name: NODE_ENV
              value: {{ .Values.app.env.NODE_ENV | quote }}
            - name: LOG_LEVEL
              value: {{ .Values.app.env.LOG_LEVEL | quote }}
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: {{ include "pmp-learning.fullname" . }}-secrets
                  key: database-url
            - name: REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: {{ include "pmp-learning.fullname" . }}-secrets
                  key: redis-url
          {{- with .Values.app.livenessProbe }}
          livenessProbe:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          {{- with .Values.app.readinessProbe }}
          readinessProbe:
            {{- toYaml . | nindent 12 }}
          {{- end }}
          resources:
            {{- toYaml .Values.app.resources | nindent 12 }}
          volumeMounts:
            - name: config
              mountPath: /app/config
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: config
          configMap:
            name: {{ include "pmp-learning.fullname" . }}-config
        - name: tmp
          emptyDir: {}
      {{- with .Values.nodeSelector }}
      nodeSelector:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.affinity }}
      affinity:
        {{- toYaml . | nindent 8 }}
      {{- end }}
      {{- with .Values.tolerations }}
      tolerations:
        {{- toYaml . | nindent 8 }}
      {{- end }}
EOF

          echo \"✅ Advanced Helm chart generated\"
          
      - name: Upload Helm Charts
        uses: actions/upload-artifact@v4
        with:
          name: helm-charts
          path: helm/
          retention-days: 30

  # Phase 4: GitOps Configuration
  gitops-setup:
    name: 🔄 GitOps Configuration
    runs-on: ubuntu-latest
    needs: [helm-charts]
    steps:
      - name: Generate ArgoCD Applications
        run: |
          echo \"🔄 Generating ArgoCD GitOps configuration...\"
          
          mkdir -p argocd/{applications,projects,repositories}
          
          # ArgoCD Project
          cat > argocd/projects/pmp-learning-project.yaml << 'EOF'
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: pmp-learning
  namespace: argocd
  labels:
    project: pmp-learning
    team: devops
spec:
  description: PMP Learning Management System Multi-Cloud Project
  
  # Source repositories
  sourceRepos:
    - 'https://github.com/pmp-learning/PMPLearningManagement'
    - 'https://charts.bitnami.com/bitnami'
    - 'https://kubernetes.github.io/ingress-nginx'
    - 'https://prometheus-community.github.io/helm-charts'
    
  # Destination clusters and namespaces
  destinations:
    - namespace: pmp-learning
      server: https://kubernetes.default.svc  # In-cluster
      name: in-cluster
    - namespace: pmp-learning-staging
      server: https://eks-staging.amazonaws.com
      name: aws-staging
    - namespace: pmp-learning
      server: https://eks-prod.amazonaws.com
      name: aws-production
    - namespace: pmp-learning
      server: https://aks-prod.azure.com
      name: azure-production
    - namespace: pmp-learning
      server: https://gke-prod.gcp.com
      name: gcp-production
      
  # Cluster resource whitelist
  clusterResourceWhitelist:
    - group: ''
      kind: Namespace
    - group: 'rbac.authorization.k8s.io'
      kind: ClusterRole
    - group: 'rbac.authorization.k8s.io'
      kind: ClusterRoleBinding
    - group: 'apiextensions.k8s.io'
      kind: CustomResourceDefinition
    - group: 'networking.istio.io'
      kind: Gateway
      
  # Namespace resource whitelist
  namespaceResourceWhitelist:
    - group: ''
      kind: ConfigMap
    - group: ''
      kind: Secret
    - group: ''
      kind: Service
    - group: ''
      kind: ServiceAccount
    - group: 'apps'
      kind: Deployment
    - group: 'apps'
      kind: ReplicaSet
    - group: 'autoscaling'
      kind: HorizontalPodAutoscaler
    - group: 'networking.k8s.io'
      kind: Ingress
    - group: 'networking.k8s.io'
      kind: NetworkPolicy
    - group: 'policy'
      kind: PodDisruptionBudget
    - group: 'monitoring.coreos.com'
      kind: ServiceMonitor
    - group: 'networking.istio.io'
      kind: VirtualService
    - group: 'networking.istio.io'
      kind: DestinationRule
    - group: 'security.istio.io'
      kind: PeerAuthentication
      
  roles:
    - name: developers
      description: Read-only access for developers
      policies:
        - p, proj:pmp-learning:developers, applications, get, pmp-learning/*, allow
        - p, proj:pmp-learning:developers, applications, sync, pmp-learning/staging-*, allow
      groups:
        - developers
    - name: devops
      description: Full access for DevOps team
      policies:
        - p, proj:pmp-learning:devops, applications, *, pmp-learning/*, allow
        - p, proj:pmp-learning:devops, repositories, *, *, allow
      groups:
        - devops
        - sre
    - name: read-only
      description: Read-only access
      policies:
        - p, proj:pmp-learning:read-only, applications, get, pmp-learning/*, allow
      groups:
        - monitoring
        - audit
        
  # Sync policies
  syncWindows:
    - kind: allow
      schedule: '0 9-17 * * MON-FRI'  # Business hours
      duration: 8h
      applications:
        - 'pmp-learning-*'
      manualSync: true
    - kind: deny
      schedule: '0 18-8 * * *'  # Outside business hours
      duration: 14h
      applications:
        - 'pmp-learning-prod-*'
      manualSync: false
EOF

          # ArgoCD Application for AWS Production
          cat > argocd/applications/pmp-learning-aws-prod.yaml << 'EOF'
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: pmp-learning-aws-prod
  namespace: argocd
  labels:
    environment: production
    cloud: aws
    region: us-west-2
  annotations:
    argocd.argoproj.io/sync-wave: \"1\"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: pmp-learning
  
  source:
    repoURL: https://github.com/pmp-learning/PMPLearningManagement
    targetRevision: main
    path: helm/pmp-learning
    helm:
      valueFiles:
        - values.yaml
        - values-production.yaml
        - values-aws.yaml
      parameters:
        - name: app.image.tag
          value: v2.0.0
        - name: app.replicaCount
          value: \"10\"
        - name: app.resources.requests.cpu
          value: 500m
        - name: app.resources.requests.memory
          value: 512Mi
        - name: app.resources.limits.cpu
          value: 2000m
        - name: app.resources.limits.memory
          value: 2Gi
        - name: app.autoscaling.maxReplicas
          value: \"100\"
        - name: postgresql.primary.persistence.size
          value: 100Gi
        - name: redis.master.persistence.size
          value: 20Gi
        
  destination:
    server: https://eks-prod.amazonaws.com
    namespace: pmp-learning
    
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
      allowEmpty: false
    syncOptions:
      - CreateNamespace=true
      - PrunePropagationPolicy=foreground
      - PruneLast=true
      - RespectIgnoreDifferences=true
      - ApplyOutOfSyncOnly=true
    retry:
      limit: 5
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
        
  revisionHistoryLimit: 10
  
  ignoreDifferences:
    - group: apps
      kind: Deployment
      jsonPointers:
        - /spec/replicas
    - group: autoscaling
      kind: HorizontalPodAutoscaler
      jsonPointers:
        - /spec/minReplicas
        - /spec/maxReplicas
        
  info:
    - name: 'Environment'
      value: 'Production'
    - name: 'Cloud Provider'
      value: 'AWS'
    - name: 'Region'
      value: 'us-west-2'
    - name: 'Cluster'
      value: 'pmp-learning-prod-eks'
EOF

          # ArgoCD Application for Azure Production
