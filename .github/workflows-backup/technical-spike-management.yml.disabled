name: "Technical Spike Management"

on:
  # 手動実行のみ（自動実行を無効化）
  workflow_dispatch:
    inputs:
      issue_number:
        description: 'Issue番号'
        required: true
        type: string

jobs:
  spike_setup:
    if: contains(github.event.issue.labels.*.name, 'type:spike')
    runs-on: ubuntu-latest
    steps:
      - name: Setup spike tracking
        uses: actions/github-script@v7
        with:
          script: |
            const { owner, repo } = context.repo;
            const issue = context.issue;
            const issueData = context.payload.issue;
            
            // Parse time-box from issue body
            const body = issueData.body || '';
            const timeboxMatch = body.match(/time-box[:\s]*(\d+)\s*story\s*points?/i);
            const timebox = timeboxMatch ? timeboxMatch[1] : '3';
            
            const spikeSetupComment = `## 🔬 Technical Spike Setup Complete
            
            **Spike Parameters:**
            - **Time-box**: ${timebox} story points (max ${parseFloat(timebox) * 0.5} days)
            - **Type**: Research and Investigation
            - **Status**: Ready for assignment
            
            ### Spike Process
            1. ✅ Spike created and time-boxed
            2. 🔄 Assignment to technical expert(s)
            3. ⏳ Research and investigation phase
            4. ⏳ Deliverables creation
            5. ⏳ Findings presentation and follow-up planning
            
            ### Success Criteria Reminder
            - Focus on answering research questions, not building production features
            - Document findings and recommendations clearly
            - Create follow-up implementation issues based on research
            - Stay within time-box limits
            
            ### Deliverables Required
            - [ ] Technical recommendation document
            - [ ] Proof of concept (if applicable)
            - [ ] Architecture diagrams
            - [ ] Implementation estimates and roadmap
            - [ ] Risk assessment
            - [ ] Follow-up issue creation
            
            **⚠️ Important**: This is time-boxed research. Focus on reducing uncertainty, not perfecting solutions.
            `;
            
            await github.rest.issues.createComment({
              owner,
              repo,
              issue_number: issue.number,
              body: spikeSetupComment
            });
            
            // Add spike-specific labels
            await github.rest.issues.addLabels({
              owner,
              repo,
              issue_number: issue.number,
              labels: [
                'needs-assignment',
                'time-boxed',
                `timebox:${timebox}sp`
              ]
            });

  spike_completion:
    if: |
      contains(github.event.issue.labels.*.name, 'type:spike') && 
      (github.event.action == 'closed' || contains(github.event.comment.body, '/spike-complete'))
    runs-on: ubuntu-latest
    steps:
      - name: Process spike completion
        uses: actions/github-script@v7
        with:
          script: |
            const { owner, repo } = context.repo;
            const issue = context.issue;
            const issueData = context.payload.issue;
            
            if (github.event.action === 'closed') {
              // Spike was closed - create completion checklist
              const completionComment = `## ✅ Spike Completion Checklist
              
              **Status**: Spike investigation completed
              **Next Steps**: Process findings and create implementation issues
              
              ### Required Follow-up Actions
              - [ ] Document key findings in issue comments
              - [ ] Upload technical deliverables (diagrams, POCs, docs)
              - [ ] Create implementation issues based on research
              - [ ] Update project roadmap with new estimates
              - [ ] Share findings with stakeholders
              - [ ] Schedule architecture review if needed
              
              ### Spike Effectiveness Review
              Please rate this spike's effectiveness:
              - **Research Questions Answered**: /10
              - **Implementation Clarity**: /10  
              - **Risk Reduction**: /10
              - **Time-box Adherence**: /10
              
              ### Implementation Planning
              Based on spike findings, create specific implementation issues:
              1. Break down work into manageable story sizes (3-8 SP)
              2. Identify any additional spikes needed
              3. Update dependency mappings
              4. Assign to appropriate team members
              
              **Remember**: Spike value is measured by uncertainty reduction and implementation readiness.
              `;
              
              await github.rest.issues.createComment({
                owner,
                repo,
                issue_number: issue.number,
                body: completionComment
              });
              
              // Add completion tracking labels
              await github.rest.issues.addLabels({
                owner,
                repo,
                issue_number: issue.number,
                labels: ['spike-completed', 'needs-follow-up']
              });
            }

  spike_monitoring:
    runs-on: ubuntu-latest
    if: github.event_name == 'schedule' || contains(github.event.issue.labels.*.name, 'spike-monitoring')
    steps:
      - name: Monitor active spikes
        uses: actions/github-script@v7
        with:
          script: |
            const { owner, repo } = context.repo;
            
            // Get all open spike issues
            const spikes = await github.rest.issues.listForRepo({
              owner,
              repo,
              labels: 'type:spike',
              state: 'open',
              per_page: 50
            });
            
            const now = new Date();
            let spikeReport = `# 🔬 Active Spikes Monitoring Report
            
            **Generated**: ${now.toISOString().split('T')[0]}
            **Total Active Spikes**: ${spikes.data.length}
            
            ## Spike Status Overview
            `;
            
            let overdueSpikes = [];
            let upcomingDeadlines = [];
            
            for (const spike of spikes.data) {
              const createdDate = new Date(spike.created_at);
              const daysActive = Math.floor((now - createdDate) / (1000 * 60 * 60 * 24));
              
              // Extract timebox from labels
              const timeboxLabel = spike.labels.find(l => l.name.startsWith('timebox:'));
              const timebox = timeboxLabel ? 
                parseFloat(timeboxLabel.name.split(':')[1].replace('sp', '')) : 3;
              const maxDays = timebox * 0.5; // 0.5 days per story point
              
              if (daysActive > maxDays) {
                overdueSpikes.push({
                  number: spike.number,
                  title: spike.title,
                  daysOverdue: daysActive - maxDays,
                  assignee: spike.assignees.length > 0 ? spike.assignees[0].login : 'unassigned'
                });
              } else if (daysActive > maxDays * 0.8) {
                upcomingDeadlines.push({
                  number: spike.number,
                  title: spike.title,
                  daysRemaining: Math.ceil(maxDays - daysActive),
                  assignee: spike.assignees.length > 0 ? spike.assignees[0].login : 'unassigned'
                });
              }
              
              spikeReport += `
            ### #${spike.number} ${spike.title}
            - **Status**: ${daysActive > maxDays ? '🔴 Overdue' : daysActive > maxDays * 0.8 ? '🟡 Due Soon' : '🟢 On Track'}
            - **Days Active**: ${daysActive} / ${maxDays} max
            - **Assignee**: ${spike.assignees.length > 0 ? '@' + spike.assignees[0].login : 'Unassigned'}
            - **Time-box**: ${timebox} story points
            `;
            }
            
            // Add alerts for overdue spikes
            if (overdueSpikes.length > 0) {
              spikeReport += `
            ## 🚨 Overdue Spikes (${overdueSpikes.length})
            
            **Immediate Action Required**:
            `;
              for (const spike of overdueSpikes) {
                spikeReport += `
            - **#${spike.number}** - ${spike.daysOverdue} days overdue (@${spike.assignee})
              - Action: Complete immediately or re-evaluate scope`;
              }
            }
            
            if (upcomingDeadlines.length > 0) {
              spikeReport += `
            ## ⏰ Upcoming Deadlines (${upcomingDeadlines.length})
            `;
              for (const spike of upcomingDeadlines) {
                spikeReport += `
            - **#${spike.number}** - ${spike.daysRemaining} days remaining (@${spike.assignee})`;
              }
            }
            
            spikeReport += `
            ## 📋 Scrum Master Actions
            - [ ] Follow up on overdue spikes immediately
            - [ ] Check progress on upcoming deadlines
            - [ ] Ensure deliverables are being documented
            - [ ] Plan spike review sessions with teams
            - [ ] Update roadmap based on spike findings
            
            ## 💡 Process Improvements
            - Consider shorter time-boxes for complex spikes
            - Ensure clear success criteria before starting
            - Regular check-ins during spike execution
            - Better documentation of findings and decisions
            `;
            
            console.log(spikeReport);
            
            // Notify overdue spike assignees
            for (const spike of overdueSpikes) {
              await github.rest.issues.createComment({
                owner,
                repo,
                issue_number: spike.number,
                body: `⚠️ **Spike Overdue Alert**
                
                This spike has exceeded its time-box by ${spike.daysOverdue} days.
                
                **Required Actions**:
                1. Document current findings immediately
                2. Create follow-up issues based on research completed
                3. Either close this spike or request extension with justification
                
                **Remember**: Spikes are time-boxed to prevent analysis paralysis.
                Partial findings are better than perfect research that never completes.
                
                @${spike.assignee} - Please update status within 24 hours.`
              });
            }
            
            // Create or update monitoring report issue
            const existingReports = await github.rest.issues.listForRepo({
              owner,
              repo,
              labels: 'spike-monitoring',
              state: 'open'
            });
            
            if (existingReports.data.length > 0) {
              await github.rest.issues.update({
                owner,
                repo,
                issue_number: existingReports.data[0].number,
                body: spikeReport
              });
            } else if (spikes.data.length > 0) {
              await github.rest.issues.create({
                owner,
                repo,
                title: `🔬 Spike Monitoring Report - ${now.toISOString().split('T')[0]}`,
                body: spikeReport,
                labels: ['spike-monitoring', 'scrum-master', 'documentation']
              });
            }

# Schedule spike monitoring daily at 9 AM JST (midnight UTC)
on:
  schedule:
    - cron: '0 0 * * *'