#!/bin/bash

# IDD Pre-commit Hook - Issue番号チェックを強制
# このフックは、コミット前にIssue番号の存在を確認します

set -e

# カラー定義
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# エラーメッセージ
print_error() {
    echo -e "${RED}❌ $1${NC}" >&2
}

# 成功メッセージ
print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

# 警告メッセージ
print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

# ステージングされたファイルを取得
staged_files=$(git diff --cached --name-only)

if [ -z "$staged_files" ]; then
    print_warning "No files staged for commit"
    exit 0
fi

# コミットメッセージファイルを確認（まだ存在しない場合）
if [ ! -f ".git/COMMIT_EDITMSG" ]; then
    # Issue番号の入力を促す
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}📋 IDD Compliance Check${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "🔍 Issue-Driven Development (IDD) requires all commits to reference an issue."
    echo ""
    echo "📝 Ensure your commit message includes:"
    echo "   • Issue reference: #<issue_number>"
    echo "   • Clear description of changes"
    echo "   • Impact on the project"
    echo ""
    echo "Example formats:"
    echo "   feat: Add authentication module (#123)"
    echo "   fix: Resolve memory leak in dashboard (#456)"
    echo "   docs: Update API documentation (#789)"
    echo ""
    
    # 最近のIssueを表示（GitHubにアクセス可能な場合）
    if command -v gh &> /dev/null; then
        echo -e "${YELLOW}Recent open issues:${NC}"
        gh issue list --limit 5 --state open 2>/dev/null || true
        echo ""
    fi
    
    print_success "Pre-commit check passed - Remember to include issue reference!"
else
    # 既存のコミットメッセージをチェック
    commit_msg=$(cat .git/COMMIT_EDITMSG 2>/dev/null || echo "")
    
    if ! echo "$commit_msg" | grep -qE '#[0-9]+'; then
        print_warning "Commit message may not contain an issue reference"
    fi
fi

# ステージングされたファイルの品質チェック
echo -e "${GREEN}📊 Checking staged files quality...${NC}"

# JavaScriptファイルのリンティング（ESLintが利用可能な場合）
js_files=$(echo "$staged_files" | grep -E '\.(js|jsx|ts|tsx)$' || true)
if [ -n "$js_files" ] && [ -f "package.json" ]; then
    if command -v npx &> /dev/null && [ -f ".eslintrc" ] || [ -f ".eslintrc.js" ] || [ -f ".eslintrc.json" ]; then
        echo "Running ESLint on JavaScript files..."
        echo "$js_files" | xargs npx eslint --quiet 2>/dev/null || {
            print_warning "ESLint found issues - consider fixing them"
        }
    fi
fi

# TODO/FIXMEコメントの検出
if echo "$staged_files" | xargs grep -l "TODO\|FIXME" 2>/dev/null; then
    print_warning "Found TODO/FIXME comments in staged files - consider creating issues for them"
fi

# 大きなファイルの警告
large_files=$(find $staged_files -type f -size +1M 2>/dev/null || true)
if [ -n "$large_files" ]; then
    print_warning "Large files detected (>1MB):"
    echo "$large_files"
fi

print_success "Pre-commit checks completed successfully!"
exit 0