#!/bin/bash

# IDD Pre-push Hook - プッシュ前のIDD準拠最終確認
# このフックは、リモートリポジトリへのプッシュ前に全コミットのIDD準拠を確認します

set -e

# カラー定義
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# 関数定義
print_error() {
    echo -e "${RED}❌ $1${NC}" >&2
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}🚀 IDD Pre-Push Validation${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# リモート情報を取得
remote="$1"
url="$2"

# プッシュされるコミットを確認
z40=0000000000000000000000000000000000000000
IFS=' '
violations=0
total_commits=0
compliant_commits=0

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = $z40 ]; then
        # ブランチ削除の場合はスキップ
        continue
    fi
    
    if [ "$remote_sha" = $z40 ]; then
        # 新規ブランチ
        range="$local_sha"
    else
        # 既存ブランチへのプッシュ
        range="$remote_sha..$local_sha"
    fi
    
    echo -e "${BLUE}Checking commits in range: $range${NC}"
    echo ""
    
    # 各コミットをチェック
    commits=$(git rev-list "$range" 2>/dev/null || echo "")
    
    for commit in $commits; do
        total_commits=$((total_commits + 1))
        commit_msg=$(git log --format=%B -n 1 "$commit")
        commit_short=$(git log --format="%h" -n 1 "$commit")
        commit_subject=$(git log --format="%s" -n 1 "$commit")
        
        # マージコミットは除外
        if echo "$commit_msg" | grep -qE '^(Merge|Revert)'; then
            print_info "[$commit_short] Merge/Revert commit - skipping"
            compliant_commits=$((compliant_commits + 1))
            continue
        fi
        
        # Issue番号チェック
        if echo "$commit_msg" | grep -qE '#[0-9]+'; then
            issue_nums=$(echo "$commit_msg" | grep -oE '#[0-9]+' | tr '\n' ' ')
            print_success "[$commit_short] IDD Compliant - References: $issue_nums"
            compliant_commits=$((compliant_commits + 1))
            
            # GitHub APIでIssueの状態を確認（オプション）
            if command -v gh &> /dev/null; then
                for issue_ref in $issue_nums; do
                    issue_num=${issue_ref#\#}
                    if gh issue view "$issue_num" &>/dev/null; then
                        issue_state=$(gh issue view "$issue_num" --json state -q .state 2>/dev/null || echo "unknown")
                        if [ "$issue_state" = "CLOSED" ]; then
                            print_warning "  Issue #$issue_num is already closed"
                        fi
                    fi
                done
            fi
        else
            print_error "[$commit_short] NO ISSUE REFERENCE: $commit_subject"
            violations=$((violations + 1))
        fi
    done
done

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# 統計情報の表示
if [ $total_commits -gt 0 ]; then
    compliance_rate=$((compliant_commits * 100 / total_commits))
    
    echo -e "${CYAN}📊 IDD Compliance Report${NC}"
    echo ""
    echo "  Total Commits:     $total_commits"
    echo "  Compliant:         $compliant_commits"
    echo "  Violations:        $violations"
    echo "  Compliance Rate:   ${compliance_rate}%"
    echo ""
    
    if [ $violations -gt 0 ]; then
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${RED}⚠️  IDD COMPLIANCE VIOLATION DETECTED${NC}"
        echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo "Found $violations commit(s) without issue references."
        echo ""
        echo "Required Actions:"
        echo "1. Create issues for uncommitted work:"
        echo "   gh issue create --title \"Description\" --body \"Details\""
        echo ""
        echo "2. Amend your commits to include issue references:"
        echo "   git rebase -i HEAD~$total_commits"
        echo "   # Then edit commit messages to include #issue_number"
        echo ""
        echo "3. Or create a tracking issue and reference it in a new commit:"
        echo "   git commit --allow-empty -m \"chore: Add tracking for previous commits (#XXX)\""
        echo ""
        echo "Learn more: https://github.com/your-org/PMPLearningManagement/blob/main/docs/IDD_AGENT_GUIDELINES.md"
        echo ""
        
        # 厳格モードの場合はプッシュをブロック
        if [ "${IDD_STRICT_MODE:-true}" = "true" ]; then
            print_error "Push blocked due to IDD violations. Set IDD_STRICT_MODE=false to override."
            exit 1
        else
            print_warning "IDD violations detected but allowing push (strict mode disabled)"
        fi
    else
        echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${GREEN}✨ Perfect IDD Compliance! All commits reference issues.${NC}"
        echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    fi
fi

# メトリクスの記録
if [ -d ".github" ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S'),push,$total_commits,$compliant_commits,$violations" >> .github/idd-metrics.csv 2>/dev/null || true
fi

exit 0